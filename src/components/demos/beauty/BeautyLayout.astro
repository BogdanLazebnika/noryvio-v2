---
import '../../../styles/demos/beauty.css';
import {beautyBase} from '../../../data/beauty';
interface Props{title:string;description?:string;active?:string}
const {title,description='AURA Atelier — інтерактивний демонстраційний сайт салону краси від Noryvio.',active=''}=Astro.props;
const nav=[['','Головна'],['services/','Послуги'],['masters/','Майстри'],['gallery/','Галерея'],['journal/','Журнал'],['contacts/','Контакти']];
---
<!doctype html><html lang="uk"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#f8f3ef"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><title>{title} — AURA Atelier · Noryvio Demo</title><link rel="preconnect" href="https://images.unsplash.com"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet"/></head>
<body class="au-body"><a class="au-skip" href="#main">Перейти до вмісту</a>
<div class="au-demo"><div class="au-wrap au-demo-inner"><span>✳ <strong>NORYVIO</strong> / LIVE DEMO</span><small>Демонстраційний салон · бронювання не реальні</small><div class="au-demo-links"><a href="/templates/">← До каталогу</a><a class="au-demo-btn" href="/#contacts">Замовити схожий сайт ↗</a></div></div></div>
<header class="au-header"><div class="au-wrap au-header-inner"><a class="au-brand" href={beautyBase}>AURA<span>ATELIER DE BEAUTÉ</span></a><nav class="au-nav" id="au-nav" aria-label="Навігація по сайту">{nav.map(([p,name])=><a href={beautyBase+p} class:list={{'au-active':p===active}}>{name}</a>)}</nav><div class="au-header-cta"><a href={beautyBase+'booking/'} class="au-btn au-btn-sm">Записатися ↗</a><button class="au-menu-toggle" type="button" id="au-menu-toggle" aria-controls="au-nav" aria-expanded="false" aria-label="Відкрити меню">☰</button></div></div></header>
<main id="main"><slot/></main>
<footer class="au-footer"><div class="au-wrap"><div class="au-footer-grid"><div><a class="au-brand au-brand-foot" href={beautyBase}>AURA<span>ATELIER DE BEAUTÉ</span></a><p>Краса як стан. Час, який належить вам. Атмосфера, в якій хочеться залишитися.</p><small>Вигаданий бренд · концепт Noryvio</small></div><div><h3>Навігація</h3>{nav.slice(0,3).map(([p,l])=><a href={beautyBase+p}>{l}</a>)}</div><div><h3>Досліджуйте</h3>{nav.slice(3).map(([p,l])=><a href={beautyBase+p}>{l}</a>)}<a href={beautyBase+'booking/'}>Онлайн-запис</a></div><div><h3>Зв’язок</h3><p>Це демонстраційна студія. Контактів реального бізнесу немає.</p><a href="/#contacts">Зробити такий сайт ↗</a></div></div><div class="au-footer-bottom">© {new Date().getFullYear()} AURA — DEMO EXPERIENCE <a href="/templates/">Повернутись до Noryvio ↗</a></div></div></footer>
<div class="au-toast" id="au-toast" role="status" aria-live="polite"></div>
<script is:inline>
(()=>{const btn=document.getElementById('au-menu-toggle'),nav=document.getElementById('au-nav');btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')!=='true';btn.setAttribute('aria-expanded',String(open));nav?.classList.toggle('au-open',open)});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('au-open');btn?.setAttribute('aria-expanded','false')}));const io='IntersectionObserver' in window?new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting){x.target.classList.add('au-visible');io.unobserve(x.target)}}),{threshold:.08}):null;document.querySelectorAll('.au-reveal').forEach(x=>io?io.observe(x):x.classList.add('au-visible'));let t;window.auToast=(s)=>{const e=document.getElementById('au-toast');e.textContent=s;e.classList.add('au-toast-on');clearTimeout(t);t=setTimeout(()=>e.classList.remove('au-toast-on'),3400)}})();
</script></body></html>
