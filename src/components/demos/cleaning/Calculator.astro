---
import {extras} from '../../../data/cleaning';
interface Props {compact?:boolean}
const {compact=false}=Astro.props;
---
<div class:list={['cl-calc',{'cl-calc--compact':compact}]} data-cl-calc>
 <div class="cl-calc__heading"><div><span class="cl-kicker">РОЗРАХУНОК ЗА 30 СЕКУНД</span><h2>Чистота з <em>прозорою ціною.</em></h2></div><span class="cl-calc__icon" aria-hidden="true">✳</span></div>
 <div class="cl-calc__section"><span class="cl-field-label">01 / Що прибираємо?</span><div class="cl-choice-row" role="group" aria-label="Тип приміщення"><button type="button" data-property="flat" aria-pressed="true">Квартира</button><button type="button" data-property="house" aria-pressed="false">Будинок</button><button type="button" data-property="office" aria-pressed="false">Офіс</button></div></div>
 <div class="cl-calc__section"><label class="cl-field-label" for="cl-area">02 / Площа приміщення <strong><output data-area-output>65 м²</output></strong></label><input id="cl-area" type="range" min="20" max="250" step="5" value="65" data-area/><div class="cl-range-ends"><span>20 м²</span><span>250 м²</span></div></div>
 <div class="cl-calc__section"><label class="cl-field-label" for="cl-service">03 / Тип прибирання</label><select id="cl-service" data-service><option value="standard">Підтримувальне</option><option value="general" selected>Генеральне</option><option value="post">Після ремонту</option></select></div>
 <details class="cl-calc__extras"><summary>Додаткові послуги <span>Додати +</span></summary><div class="cl-calc__extras-grid">{extras.map(x=><label class="cl-extra"><input type="checkbox" data-extra={x.id} value={x.price}/><span>{x.name}</span><b>+{x.price} ₴</b></label>)}</div></details>
 <div class="cl-calc__total"><div><span>Орієнтовна вартість</span><strong data-total>4 230 ₴</strong><small>Умовні демо-ціни · без оплати</small></div><span class="cl-calc__spark" aria-hidden="true">✦</span></div>
 <a class="cl-button cl-button--full" data-book href="/demo/cleaning/booking/">Оформити демо-заявку <span aria-hidden="true">↗</span></a>
 <p class="cl-calc__disclaimer">Це інтерактивний приклад, не комерційна пропозиція. Підсумкова ціна в реальному сервісі залежить від об’єкта.</p>
</div>
<script is:inline>
(()=>{
 const root=document.querySelectorAll('[data-cl-calc]');
 const format=n=>new Intl.NumberFormat('uk-UA').format(n)+' ₴';
 const key='noryvio_luma_estimate_v1';
 const defaults={property:'flat',area:65,service:'general',extras:[]};
 const rates={standard:38,general:65,post:85};
 const factors={flat:1,house:1.15,office:1.08};
 const read=()=>{try{const value=JSON.parse(localStorage.getItem(key)||'null');return value && typeof value==='object'? {...defaults,...value}: {...defaults}}catch{return {...defaults}}};
 const save=(s)=>{try{localStorage.setItem(key,JSON.stringify(s))}catch{}};
 function compute(s){const area=Math.min(250,Math.max(20,Number(s.area)||65));const rate=rates[s.service]||65;const factor=factors[s.property]||1;let sum=Math.round(area*rate*factor/10)*10;const options={fridge:260,oven:320,windows:480,cabinets:300,balcony:280,pet:170};(Array.isArray(s.extras)?s.extras:[]).forEach(id=>sum+=options[id]||0);return sum}
 window.LumaEstimate={read,save,compute,format};
 root.forEach(el=>{
  let s=read();
  s.extras=Array.isArray(s.extras)?s.extras:[];
  const requested=new URLSearchParams(location.search).get('service');
  if(requested==='office')s.property='office';else if(requested==='windows'){s.extras=[...new Set([...s.extras,'windows'])]}else if(requested==='standard'||requested==='general'||requested==='post')s.service=requested;
  const area=el.querySelector('[data-area]'),service=el.querySelector('[data-service]');
  if(area)area.value=String(Math.max(20,Math.min(250,Number(s.area)||65)));
  if(service)service.value=(s.service in rates)?s.service:'general';
  function paint(){el.querySelectorAll('[data-property]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.property===s.property)));el.querySelectorAll('[data-extra]').forEach(b=>b.checked=s.extras.includes(b.dataset.extra));el.querySelector('[data-area-output]').textContent=s.area+' м²';el.querySelector('[data-total]').textContent=format(compute(s));save(s)}
  el.querySelectorAll('[data-property]').forEach(b=>b.addEventListener('click',()=>{s.property=b.dataset.property;paint()}));
  area?.addEventListener('input',()=>{s.area=Number(area.value);paint()});
  service?.addEventListener('change',()=>{s.service=service.value;paint()});
  el.querySelectorAll('[data-extra]').forEach(b=>b.addEventListener('change',()=>{s.extras=Array.from(el.querySelectorAll('[data-extra]:checked')).map(e=>e.dataset.extra);paint()}));
  paint();
 });
})();
</script>
