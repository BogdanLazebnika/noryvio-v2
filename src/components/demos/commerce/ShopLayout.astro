---
import '../../../styles/demos/commerce.css';
import {shopBase} from '../../../data/commerce';
interface Props{title:string;description?:string;active?:string}
const {title,description='FORM / OBJECTS — концепт інтерактивного інтернет-магазину Noryvio, без реальних продажів.',active=''}=Astro.props;
const nav=[['','Головна'],['catalog/','Каталог'],['about/','Про бренд'],['journal/','Журнал'],['delivery/','Доставка'],['contacts/','Контакти']];
---
<!doctype html><html lang="uk"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b1119"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><title>{title} — FORM / OBJECTS · Noryvio Demo</title><link rel="preconnect" href="https://images.unsplash.com"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head>
<body class="fo-body"><a href="#main" class="fo-skip">Перейти до вмісту</a><div class="fo-demo"><div class="fo-wrap fo-demo-inner"><span>◈ <strong>NORYVIO</strong> / LIVE DEMO</span><small>Інтерактивний магазин · покупки демонстраційні</small><div><a href="/templates/">← До каталогу</a><a class="fo-demo-order" href="/#contacts">Замовити схожий ↗</a></div></div></div>
<div class="fo-topline">CURATED OBJECTS FOR MODERN LIVING <span>FREE THINKING / NO REAL ORDERS</span></div>
<header class="fo-header"><div class="fo-wrap fo-header-inner"><a class="fo-logo" href={shopBase}>FORM<span>/ OBJECTS</span></a><nav id="fo-nav" class="fo-nav" aria-label="Навігація магазину">{nav.map(([u,t])=><a class:list={{'fo-active':active===u}} href={shopBase+u}>{t}</a>)}</nav><div class="fo-header-right"><a href={shopBase+'favorites/'} aria-label="Обране">♡ <span id="fo-fav-count">0</span></a><a href={shopBase+'cart/'} aria-label="Кошик">Сумка <b id="fo-cart-count">0</b></a><button type="button" id="fo-menu-btn" aria-controls="fo-nav" aria-expanded="false" aria-label="Відкрити меню">☰</button></div></div></header>
<main id="main"><slot/></main>
<footer class="fo-footer"><div class="fo-wrap"><div class="fo-footer-intro"><h2>FORM <em>/ OBJECTS</em></h2><p>Продуманий вибір речей для сучасного ритму. Концептуальна вітрина без реальних продажів.</p></div><div class="fo-footer-grid"><div><h3>Досліджуйте</h3>{nav.slice(0,3).map(([p,t])=><a href={shopBase+p}>{t}</a>)}</div><div><h3>Інформація</h3>{nav.slice(3).map(([p,t])=><a href={shopBase+p}>{t}</a>)}</div><div><h3>Ваш простір</h3><a href={shopBase+'favorites/'}>Обране</a><a href={shopBase+'cart/'}>Кошик</a><a href="/#contacts">Хочу свій інтернет-магазин ↗</a></div><div><h3>Демонстраційний режим</h3><p>Ціни умовні. Платежі не приймаються, товари не відправляються.</p></div></div><div class="fo-footer-bottom"><span>© {new Date().getFullYear()} FORM / OBJECTS · NORYVIO CONCEPT</span><a href="/templates/">Повернутися до Noryvio ↗</a></div></div></footer><div id="fo-toast" class="fo-toast" role="status" aria-live="polite"></div>
<script is:inline>
(()=>{const KEY='nv2_form_cart_v1',FKEY='nv2_form_favs_v1';const read=(k)=>{try{const v=JSON.parse(localStorage.getItem(k)||'{}');return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}catch{return {}}};const write=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};let timeout;const toast=s=>{const el=document.getElementById('fo-toast');el.textContent=s;el.classList.add('fo-toast-on');clearTimeout(timeout);timeout=setTimeout(()=>el.classList.remove('fo-toast-on'),3000)};const refresh=()=>{let cart=read(KEY),favs=read(FKEY);document.getElementById('fo-cart-count').textContent=Object.values(cart).reduce((s,n)=>s+Math.max(0,Number(n)||0),0);document.getElementById('fo-fav-count').textContent=Object.values(favs).filter(Boolean).length;document.querySelectorAll('[data-favorite]').forEach(b=>{const selected=!!favs[b.dataset.favorite];b.setAttribute('aria-pressed',String(selected));b.textContent=selected?'♥':'♡'})};window.foShop={readCart:()=>read(KEY),readFav:()=>read(FKEY),refresh,add:id=>{const cart=read(KEY);cart[id]=Math.min(50,(cart[id]||0)+1);write(KEY,cart);refresh();toast('Додано до демонстраційного кошика')},set:(id,qty)=>{let c=read(KEY);if(qty<=0)delete c[id];else c[id]=Math.min(50,qty);write(KEY,c);refresh();window.dispatchEvent(new CustomEvent('fo-cart-changed'))},toggle:id=>{let f=read(FKEY);f[id]=!f[id];write(FKEY,f);refresh();toast(f[id]?'Додано в обране':'Прибрано з обраного')},clear:()=>{write(KEY,{});refresh();window.dispatchEvent(new CustomEvent('fo-cart-changed'))}};document.addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add){window.foShop.add(add.dataset.add)}const fav=e.target.closest('[data-favorite]');if(fav){window.foShop.toggle(fav.dataset.favorite)}});const btn=document.getElementById('fo-menu-btn'),nav=document.getElementById('fo-nav');btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')!=='true';btn.setAttribute('aria-expanded',String(open));nav.classList.toggle('fo-open',open)});nav?.querySelectorAll('a').forEach(x=>x.addEventListener('click',()=>{nav.classList.remove('fo-open');btn.setAttribute('aria-expanded','false')}));refresh();const io='IntersectionObserver' in window?new IntersectionObserver(entries=>entries.forEach(x=>{if(x.isIntersecting){x.target.classList.add('fo-visible');io.unobserve(x.target)}}),{threshold:.06}):null;document.querySelectorAll('.fo-reveal').forEach(x=>io?io.observe(x):x.classList.add('fo-visible'))})();
</script></body></html>
