      "No complicated process or unexpected steps. You know what's happening with your project, what you're paying for and how we get to launch.",
    marker: "FOUR STEPS TO LAUNCH",
    steps: [
      {
        number: "01",
        icon: "monitor" as const,
        label: "DISCOVERY",
        title: "We discuss your idea",
        description:
          "We learn about your business, audience and goals, then determine the right kind of website.",
        points: ["Enquiry and consultation", "Goals and features"]
      },
      {
        number: "02",
        icon: "layers" as const,
        label: "PLAN & DEPOSIT",
        title: "We agree on the terms",
        description:
          "We confirm the scope, price and payment schedule. Work starts once the terms and deposit are agreed.",
        points: ["Design and structure", "Deposit + 12 payments"]
