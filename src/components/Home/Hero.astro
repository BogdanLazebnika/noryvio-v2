
---
import "./Hero.css";

import Icon from "../ui/Icon.astro";

import {
  getLangFromUrl,
  useTranslations,
  localizedPath
} from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang).hero;

const contactUrl = localizedPath("/#contacts", lang);
const templatesUrl = localizedPath("/#templates", lang);

const benefits = [
  {
    icon: "monitor" as const,
    title: t.benefitOne
  },
  {
    icon: "shield" as const,
    title: t.benefitTwo
  },
  {
    icon: "layers" as const,
    title: t.benefitThree
  }
];

const features = lang === "uk"
  ? [
      {
        icon: "layers" as const,
        title: "Гнучкі рішення",
        text: "Під потреби бізнесу"
      },
      {
        icon: "bolt" as const,
        title: "Швидкий старт",
        text: "Без зайвої складності"
      },
      {
        icon: "monitor" as const,
        title: "Адаптивний сайт",
        text: "Для всіх пристроїв"
      },
      {
        icon: "shield" as const,
        title: "Супровід",
        text: "Після запуску"
      }
    ]
  : [
      {
        icon: "layers" as const,
        title: "Flexible solutions",
        text: "For your business"
      },
      {
        icon: "bolt" as const,
        title: "Fast start",
        text: "Without complexity"
      },
      {
        icon: "monitor" as const,
        title: "Responsive websites",
        text: "Across all devices"
      },
      {
        icon: "shield" as const,
        title: "Ongoing support",
        text: "After launch"
      }
    ];
---

<section
  class="nv2-hero"
  data-nv2-hero
  aria-labelledby="nv2-hero-title"
>

  <!-- Фонові світлові ефекти -->
  <div
    class="nv2-hero__atmosphere"
    aria-hidden="true"
  >
    <span
      class="nv2-hero__light nv2-hero__light--one"
    ></span>

    <span
      class="nv2-hero__light nv2-hero__light--two"
    ></span>

    <span
      class="nv2-hero__arc nv2-hero__arc--one"
    ></span>

    <span
      class="nv2-hero__arc nv2-hero__arc--two"
    ></span>
  </div>

  <div class="nv2-hero__container">

    <!-- Ліва частина -->
    <div class="nv2-hero__content">

      <div
        class="nv2-hero__eyebrow"
        data-nv2-reveal
        data-nv2-delay="0"
      >
        <span
          class="nv2-hero__eyebrow-dot"
          aria-hidden="true"
        ></span>

        {t.eyebrow}
      </div>

      <h1
        id="nv2-hero-title"
        class="nv2-hero__title"
        data-nv2-reveal
        data-nv2-delay="65"
      >
        {t.title}
        <span>{t.titleAccent}</span>
      </h1>

      <p
        class="nv2-hero__description"
        data-nv2-reveal
        data-nv2-delay="115"
      >
        {t.description}
      </p>

      <div
        class="nv2-hero__actions"
        data-nv2-reveal
        data-nv2-delay="165"
      >
        <a
          class="nv2-hero__button nv2-hero__button--primary"
          href={contactUrl}
        >
          <span>{t.primaryCta}</span>
          <Icon name="arrow-up-right" size={20} />
        </a>

        <a
          class="nv2-hero__button nv2-hero__button--secondary"
          href={templatesUrl}
        >
          <Icon name="layers" size={19} />
          <span>{t.secondaryCta}</span>
        </a>
      </div>

      <div
        class="nv2-hero__benefits"
        data-nv2-reveal
        data-nv2-delay="210"
        aria-label={
          lang === "uk"
            ? "Наші переваги"
            : "Our advantages"
        }
      >
        {benefits.map((benefit) => (
          <div class="nv2-hero__benefit">
            <Icon
              name={benefit.icon}
              size={22}
            />
            <span>{benefit.title}</span>
          </div>
        ))}
      </div>

    </div>

    <!-- Ноутбук та скелі -->
    <div
      class="nv2-hero__visual"
      data-nv2-reveal
      data-nv2-delay="110"
      aria-hidden="true"
    >
      <div class="nv2-hero__visual-glow"></div>

      <img
        class="nv2-hero__scene"
        src="/images/hero/hero-scene.webp"
        alt=""
        width="896"
        height="674"
        fetchpriority="high"
        decoding="async"
      />

      <img
        class="nv2-hero__rock"
        src="/images/hero/rock-accent.webp"
        alt=""
        width="580"
        height="400"
        loading="lazy"
        decoding="async"
      />
    </div>

  </div>

  <!-- Нижня панель переваг -->
  <div
    class="nv2-hero__strip-wrap"
    data-nv2-reveal
    data-nv2-delay="80"
  >
    <div class="nv2-hero__strip">

      {features.map((feature) => (
        <div class="nv2-hero__strip-item">

          <div class="nv2-hero__strip-icon">
            <Icon
              name={feature.icon}
              size={28}
            />
          </div>

          <div class="nv2-hero__strip-copy">
            <strong>{feature.title}</strong>
            <span>{feature.text}</span>
          </div>

        </div>
      ))}

    </div>
  </div>

</section>

<script>
  import { registerReveals } from "../../scripts/reveal";

  const hero = document.querySelector<HTMLElement>("[data-nv2-hero]");
  registerReveals(hero, "[data-nv2-reveal]", "data-nv2-delay", 730);

  // Ambient hero glow is independent from scroll reveals.
  if (hero && typeof HTMLElement.prototype.animate === "function") {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let ambientAnimations: Animation[] = [];

    function startAmbientAnimations() {
      if (reducedMotion.matches) return;
      const layers = [
        { selector: ".nv2-hero__arc--one", min: .72, max: 1, duration: 10000 },
        { selector: ".nv2-hero__arc--two", min: .4, max: .65, duration: 12500 },
        { selector: ".nv2-hero__visual-glow", min: .65, max: .9, duration: 8500 }
      ];
      for (const layer of layers) {
        const element = hero?.querySelector<HTMLElement>(layer.selector);
        if (!element) continue;
        ambientAnimations.push(element.animate(
          [{ opacity: layer.min }, { opacity: layer.max }, { opacity: layer.min }],
          { duration: layer.duration, iterations: Infinity, easing: "ease-in-out" }
        ));
      }
    }
    startAmbientAnimations();
    reducedMotion.addEventListener("change", () => {
      for (const animation of ambientAnimations) animation.cancel();
      ambientAnimations = [];
      if (!reducedMotion.matches) startAmbientAnimations();
    });
  }
</script>
