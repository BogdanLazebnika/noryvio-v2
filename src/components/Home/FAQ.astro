---
import "./FAQ.css";
import Icon from "../ui/Icon.astro";
import { getLangFromUrl, localizedPath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);

// Keep these answers aligned with Pricing.astro and the agreed service terms.
// A deposit + 12 monthly payments covers website development.
const content = {
  uk: {
    eyebrow: "05 / ЧАСТІ ЗАПИТАННЯ",
    title: "Усе важливе.",
    accent: "Без зайвих питань.",
    description:
      "Розповідаємо про оплату частинами, домен, розробку й підтримку. Прозорі умови ще до першого платежу.",
    countLabel: "ВІДПОВІДЕЙ НА ГОЛОВНЕ",
    noteEyebrow: "ЗРОЗУМІЛА МОДЕЛЬ ОПЛАТИ",
    noteTitle: "Аванс + 12 платежів",
    noteText:
      "Ви сплачуєте початковий внесок, а решту вартості розробки — рівними платежами після запуску сайту.",
    noteLink: "Порахувати вартість",
    bottomEyebrow: "ЗАЛИШИЛИСЬ ЗАПИТАННЯ?",
    bottomTitle: "Обговоримо ваш проєкт особисто.",
    bottomText:
      "Розкажіть, який сайт потрібен. Уточнимо функції, строки та остаточні умови без прихованих обіцянок.",
    bottomCta: "Залишити заявку",
    questions: [
      {
        question: "Чи потрібно оплачувати всю розробку одразу?",
        answer:
          "Ні. Спочатку вносите аванс: 1 990 ₴ для Landing Page, 3 990 ₴ для Business Website або 6 990 ₴ для базового E-commerce. Після запуску сайту сплачуєте ще 12 рівних щомісячних платежів відповідно до обраного пакета. Повну суму показує калькулятор у розділі тарифів. Графік фіксуємо до початку роботи."
      },
      {
        question: "Яка повна вартість кожного типу сайту?",
        answer:
          "Базовий Landing Page — 7 870 ₴, Business Website — 14 670 ₴, невеликий E-commerce — від 24 870 ₴ за погодженого стандартного функціоналу. Це аванс разом із 12 платежами за розробку. Складні інтеграції, нестандартні функції та додаткові роботи оцінюємо окремо до замовлення."
      },
      {
        question: "Що покриває перший внесок і коли починається робота?",
        answer:
          "Початковий внесок — частина загальної вартості розробки, а не додаткова плата. Перед оплатою узгоджуємо структуру сайту, обсяг робіт, строки, кількість правок і графік платежів. Після погодження умов та внесення авансу беремо проєкт у роботу."
      },
      {
        question: "Домен, хостинг і SSL справді входять у ціну?",
        answer:
