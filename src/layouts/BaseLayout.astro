---
/** NORYVIO 2.0 — Global page layout */
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";
import "@fontsource-variable/manrope";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/v2/tokens.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  alternatePaths?: { uk: string; en: string };
}

const { title, description, noindex = false, ogImage, alternatePaths } = Astro.props;

// Keep existing staging protections until the real domain and public SEO launch are ready.
const searchIndexReady = process.env.NORYVIO_LIVE === "true" && Boolean(Astro.site);
const shouldNoindex = noindex || !searchIndexReady;
const lang = getLangFromUrl(Astro.url);
const isUkrainian = lang === "uk";
const ogLocale = isUkrainian ? "uk_UA" : "en_US";
const skipLinkText = isUkrainian ? "Перейти до основного вмісту" : "Skip to main content";

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

// On staging, point social image to the public Pages deployment, not localhost.
// After setting NORYVIO_SITE_URL for the final domain, Astro.site takes precedence.
const socialBase = Astro.site ?? new URL("https://noryvio-v2.pages.dev");
const ogImageUrl = new URL(ogImage || "/images/og/noryvio-social-preview.jpg", socialBase).href;
const alternateUrls = Astro.site && alternatePaths?.uk && alternatePaths?.en
  ? {
      uk: new URL(alternatePaths.uk, Astro.site).href,
      en: new URL(alternatePaths.en, Astro.site).href
    }
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070d12" />

    <!-- Noryvio favicon and Apple home screen icon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    {alternateUrls && (
      <>
        <link rel="alternate" hreflang="uk" href={alternateUrls.uk} />
        <link rel="alternate" hreflang="en" href={alternateUrls.en} />
        <link rel="alternate" hreflang="x-default" href={alternateUrls.uk} />
      </>
    )}

    <!-- Link preview for Telegram, Messenger, Discord and other services -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Noryvio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Noryvio — створення сучасних сайтів для бізнесу" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <slot name="head" />
  </head>
  <body>
    <a class="nv-skip-link" href="#main-content">{skipLinkText}</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>

<style>
  .nv-skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 9999;
    padding: 12px 18px;
    border: 2px solid #24e5c1;
    border-radius: 12px;
    background: #101b22;
    color: #f5f8fa;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-160%);
  }
  .nv-skip-link:focus-visible {
    transform: translateY(0);
    outline: none;
  }
</style>
