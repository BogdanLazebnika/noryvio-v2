---
import Layout from '../../../components/demos/cleaning/CleanLayout.astro';
import {base} from '../../../data/cleaning';
---
<Layout title="Демо-запис"><section class="cl-page-top cl-page-top--compact"><div class="cl-wrap"><span class="cl-kicker">06 / ОНЛАЙН-ЗАПИС</span><h1>Майже готово.<br/><em>Залишилися деталі.</em></h1><p>Заповніть форму та подивіться, як міг би працювати реальний процес оформлення. Ніякі дані не передаються на сервер.</p></div></section><section class="cl-section"><div class="cl-wrap cl-booking"><div class="cl-booking__form"><form id="cl-booking-form" novalidate><div class="cl-form-heading"><span>01 / ДЕТАЛІ ЗАМОВЛЕННЯ</span><h2>Ваше прибирання</h2></div><div class="cl-form-row"><label>Тип приміщення<select name="property" id="book-property"><option value="flat">Квартира</option><option value="house">Будинок</option><option value="office">Офіс</option></select></label><label>Вид прибирання<select name="service" id="book-service"><option value="standard">Підтримувальне</option><option value="general">Генеральне</option><option value="post">Після ремонту</option></select></label></div><div class="cl-form-row"><label>Площа, м²<input type="number" name="area" id="book-area" min="20" max="250" value="65" required/></label><label>Бажана дата<input type="date" name="date" id="book-date" required/></label></div><div class="cl-form-row"><label>Зручний час<select name="time" required><option value="">Оберіть час</option><option>09:00</option><option>11:00</option><option>13:00</option><option>15:00</option><option>17:00</option></select></label><label>Тип приміщення за доступом<select name="access"><option>Ліфт / без особливостей</option><option>Без ліфта</option><option>Потрібен пропуск</option></select></label></div><div class="cl-form-heading cl-form-heading--second"><span>02 / ДАНІ ДЛЯ ЗВ’ЯЗКУ</span><h2>Трохи про вас</h2></div><div class="cl-form-row"><label>Ваше ім'я<input type="text" name="name" autocomplete="name" maxlength="80" required placeholder="Як до вас звертатися"/></label><label>Телефон (демо)<input type="tel" name="phone" autocomplete="off" required minlength="9" maxlength="20" placeholder="+380 ..."/></label></div><label>Побажання <span class="cl-optional">необов'язково</span><textarea name="notes" rows="3" maxlength="500" placeholder="На що звернути увагу?"></textarea></label><label class="cl-consent"><input type="checkbox" required name="demoConsent"/><span>Розумію, що це демонстрація: форма не надсилає дані та не створює реального бронювання.</span></label><div class="cl-form-error" id="cl-form-error" role="alert" aria-live="polite"></div><button class="cl-button cl-button--full" type="submit">Підтвердити демо-заявку ↗</button></form><div id="cl-confirmation" class="cl-confirmation" hidden tabindex="-1"><span class="cl-confirmation__icon">✓</span><span class="cl-kicker">ДЕМО-ЗАЯВКУ СФОРМОВАНО</span><h2>Дякуємо за тест!</h2><p>Ось як могло б виглядати підтвердження запису на справжньому сайті.</p><div id="cl-confirmation-details"></div><p><strong>Жодних даних не надіслано.</strong> Це локальна демонстрація, не реальне бронювання.</p><button class="cl-button cl-button--outline" id="cl-new-booking" type="button">Створити ще одну заявку</button><a class="cl-link" href="/#contacts">Замовити подібний сайт ↗</a></div></div><aside class="cl-booking__side"><div class="cl-booking__summary"><span class="cl-kicker">ВАШ РОЗРАХУНОК</span><h3>Попередній кошторис</h3><div id="cl-book-summary"></div><strong class="cl-booking__price" id="cl-book-price">— ₴</strong><p>Орієнтовний розрахунок на основі демо-тарифів. Без реального замовлення або оплати.</p><a href={base+'prices/'}>← Повернутися до калькулятора</a></div><div class="cl-booking__tip">✳ <p>Ви тестуєте сценарій онлайн-бронювання для портфоліо Noryvio. Персональні дані краще вводити умовні.</p></div></aside></div></section>
<script is:inline>
(()=>{
 const form=document.querySelector('#cl-booking-form');if(!form)return;
 const key='noryvio_luma_estimate_v1';let data={property:'flat',area:65,service:'general',extras:[]};
 try{const saved=JSON.parse(localStorage.getItem(key)||'null');if(saved&&typeof saved==='object')data={...data,...saved}}catch{}
 const prices={standard:38,general:65,post:85},factors={flat:1,house:1.15,office:1.08};
 const extras={fridge:260,oven:320,windows:480,cabinets:300,balcony:280,pet:170};
 const labels={standard:'Підтримувальне',general:'Генеральне',post:'Після ремонту'};
 const props={flat:'Квартира',house:'Будинок',office:'Офіс'};
 const $=sel=>document.querySelector(sel);
 const property=$('#book-property'),service=$('#book-service'),area=$('#book-area');
 property.value=data.property in factors?data.property:'flat';service.value=data.service in prices?data.service:'general';area.value=String(Math.max(20,Math.min(250,Number(data.area)||65)));
 const today=new Date();today.setMinutes(today.getMinutes()-today.getTimezoneOffset());$('#book-date').min=today.toISOString().slice(0,10);
 function refresh(){const p=property.value,s=service.value,a=Math.min(250,Math.max(20,Number(area.value)||20));const total=Math.round(a*prices[s]*factors[p]/10)*10 + (Array.isArray(data.extras)?data.extras:[]).reduce((sum,id)=>sum+(extras[id]||0),0);$('#cl-book-summary').textContent=`${props[p]} · ${a} м² · ${labels[s]} · ${(data.extras||[]).length} доп. опцій`;$('#cl-book-price').textContent=new Intl.NumberFormat('uk-UA').format(total)+' ₴';return total}
 [property,service,area].forEach(el=>el.addEventListener('input',refresh));refresh();
 form.addEventListener('submit',e=>{e.preventDefault();const error=$('#cl-form-error');error.textContent='';if(!form.checkValidity()){form.reportValidity();error.textContent='Перевірте обов’язкові поля та згоду на деморежим.';return}const fd=new FormData(form),date=String(fd.get('date'));if(date<$('#book-date').min){error.textContent='Оберіть сьогоднішню або майбутню дату.';return}const name=String(fd.get('name')).trim(),phone=String(fd.get('phone')).trim();if(name.length<2||phone.replace(/\D/g,'').length<9){error.textContent='Вкажіть ім’я та номер телефону у правильному форматі.';return}const detail=$('#cl-confirmation-details');detail.replaceChildren();const rows=[['Послуга',labels[service.value]],['Приміщення',props[property.value]],['Площа',area.value+' м²'],['Дата',date],['Час',String(fd.get('time'))],['Орієнтовна ціна',new Intl.NumberFormat('uk-UA').format(refresh())+' ₴']];rows.forEach(([k,v])=>{const row=document.createElement('div');const key=document.createElement('span');const val=document.createElement('strong');key.textContent=k;val.textContent=v;row.append(key,val);detail.append(row)});form.hidden=true;$('#cl-confirmation').hidden=false;$('#cl-confirmation').focus();window.scrollTo({top:Math.max(0,$('#cl-confirmation').getBoundingClientRect().top+window.scrollY-120),behavior:'smooth'})});
 $('#cl-new-booking')?.addEventListener('click',()=>{form.reset();form.hidden=false;$('#cl-confirmation').hidden=true;refresh();form.querySelector('input[name="name"]')?.focus()});
})();
</script></Layout>
