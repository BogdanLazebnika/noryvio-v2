---
import Layout from '../../../components/demos/cleaning/CleanLayout.astro';
import Calculator from '../../../components/demos/cleaning/Calculator.astro';
import {services} from '../../../data/cleaning';
---
<Layout title="Ціни та калькулятор" active="prices/"><section class="cl-page-top"><div class="cl-wrap"><span class="cl-kicker">02 / ЦІНИ</span><h1>Жодних загадок.<br/><em>Тільки зрозумілі цифри.</em></h1><p>Порівняйте базові тарифи й налаштуйте власний набір послуг в інтерактивному калькуляторі.</p></div></section><section class="cl-section cl-section--mint"><div class="cl-wrap cl-prices-layout"><div class="cl-reveal"><span class="cl-kicker">БАЗОВІ ОРІЄНТИРИ</span><h2>Обирайте<br/><em>свій рівень догляду.</em></h2><div class="cl-price-list">{services.map(s=><div><span>{s.name}</span><strong>від {s.price} ₴{s.id==='windows'?' / шт.':' / м²'}</strong></div>)}</div><p class="cl-note">Тарифи демонстраційні. Мінімальна вартість та націнки можуть бути іншими у реальній компанії.</p></div><Calculator compact={true}/></div></section><section class="cl-section"><div class="cl-wrap"><div class="cl-section-heading"><div><span class="cl-kicker">ВАРТІСТЬ БЕЗ СЮРПРИЗІВ</span><h2>Що впливає<br/><em>на розрахунок?</em></h2></div></div><div class="cl-feature-grid">{[['01','Площа','Чим більша площа, тим більше часу й ресурсів потрібно.'],['02','Тип прибирання','Підтримувальне, генеральне чи післяремонтне.'],['03','Особливості простору','Будинок, квартира або робоче приміщення.'],['04','Додаткові опції','Духовка, холодильник, вікна та інші зони.']].map(([n,t,d])=><div class="cl-feature cl-reveal"><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section></Layout>
