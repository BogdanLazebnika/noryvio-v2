---
import Layout from '../../../components/demos/cleaning/CleanLayout.astro';
import {base,faqs,photos} from '../../../data/cleaning';
---
<Layout title="Контакти та запитання" active="contacts/"><section class="cl-page-top"><div class="cl-wrap"><span class="cl-kicker">05 / КОНТАКТИ</span><h1>Поставити питання.<br/><em>Знайти рішення.</em></h1><p>Відповіді на часті запитання і швидкий перехід до демонстраційної заявки.</p></div></section><section class="cl-section"><div class="cl-wrap cl-contact-layout"><div class="cl-contact-card cl-reveal"><span class="cl-kicker">ЦЕ ДЕМОНСТРАЦІЙНИЙ САЙТ</span><h2>На зв’язку —<br/><em>через Noryvio.</em></h2><p>LUMA не є реальною клінінговою компанією, тому тут немає вигаданої адреси, телефону чи карти. Якщо хочете подібний сайт для свого бізнесу — зв'яжіться зі студією Noryvio.</p><a class="cl-button" href="/#contacts">Зв'язатися з Noryvio ↗</a><a class="cl-contact-card__secondary" href={base+'booking/'}>Або протестувати демо-запис →</a></div><div class="cl-contact-picture"><img src={photos.plant} alt="Спокійний світлий інтер'єр" loading="lazy"/></div></div></section><section class="cl-section cl-section--mint"><div class="cl-wrap cl-faq-grid"><div><span class="cl-kicker">ПИТАННЯ ТА ВІДПОВІДІ</span><h2>Корисно знати<br/><em>заздалегідь.</em></h2></div><div class="cl-accordion">{faqs.map(([q,a],i)=><details><summary><span>0{i+1} / {q}</span><b>+</b></summary><p>{a}</p></details>)}</div></div></section></Layout>
