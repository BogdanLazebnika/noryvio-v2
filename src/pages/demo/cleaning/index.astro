---
import Layout from '../../../components/demos/cleaning/CleanLayout.astro';
import Calculator from '../../../components/demos/cleaning/Calculator.astro';
import {base,photos,services,faqs} from '../../../data/cleaning';
---
<Layout title="Чистий простір, легші думки" active="">
 <section class="cl-hero"><div class="cl-hero__photo" style={`background-image:url('${photos.hero}')`}></div><div class="cl-hero__shade"></div><div class="cl-wrap cl-hero__inner"><div class="cl-hero__copy cl-reveal"><div class="cl-hero__badge"><span>✳</span> ПРОСТІР, У ЯКОМУ ХОЧЕТЬСЯ ЖИТИ</div><h1>Вдихніть <em>легкість.</em><br/>Ми подбаємо<br/>про решту.</h1><p>Професійний догляд за оселею та робочим простором. Менше справ у списку — більше часу на важливе.</p><div class="cl-hero__actions"><a class="cl-button" href="#calculate">Розрахувати вартість ↗</a><a class="cl-button cl-button--glass" href={base+'services/'}>Переглянути послуги →</a></div><div class="cl-hero__foot"><span>✦ Зручне онлайн-замовлення</span><span>✦ Прозорий розрахунок</span></div></div><div class="cl-hero__mini cl-reveal"><span>01 / 03</span><p>Чистота, що відчувається.</p><strong>luma / clean living</strong></div></div></section>
 <div class="cl-strip"><div class="cl-wrap"><span>✳ Дбайливий підхід</span><span>✳ Продумані пакети</span><span>✳ Прозора вартість</span><span>✳ Сервіс без зайвого клопоту</span></div></div>
 <section class="cl-section" id="services"><div class="cl-wrap"><div class="cl-section-heading cl-reveal"><div><span class="cl-kicker">ЩО МИ РОБИМО</span><h2>Для кожного простору —<br/><em>своя турбота.</em></h2></div><p>Від швидкого освіження до генерального прибирання. Обирайте послуги, які відповідають вашому ритму.</p></div><div class="cl-services-grid">{services.slice(0,4).map((s,i)=><a class="cl-service-card cl-reveal" href={base+'services/#'+s.id}><img src={s.photo} alt={s.name} loading="lazy"/><div class="cl-service-card__bottom"><span>0{i+1} / {s.tag}</span><h3>{s.name} <b>↗</b></h3><p>{s.short}</p></div></a>)}</div><div class="cl-center"><a class="cl-link" href={base+'services/'}>Усі послуги <span>↗</span></a></div></div></section>
 <section class="cl-approach"><div class="cl-approach__photo"><img src={photos.living} alt="Світла затишна вітальня" loading="lazy"/></div><div class="cl-approach__content cl-reveal"><span class="cl-kicker">НАША ФІЛОСОФІЯ</span><h2>Місце для життя.<br/><em>Не для списків справ.</em></h2><p>Дім має бути простором, де можна відновити сили. Саме тому ми уявили LUMA як сервіс, який бере рутину на себе і залишає вам відчуття свободи.</p><div class="cl-value-grid"><div><span>01</span><strong>Зрозуміло</strong><p>Видимий склад послуг і розрахунок ще до заявки.</p></div><div><span>02</span><strong>Гнучко</strong><p>Ви самі визначаєте формат, площу й опції.</p></div><div><span>03</span><strong>Спокійно</strong><p>Простий сценарій бронювання без зайвих дзвінків.</p></div></div><a class="cl-link" href={base+'about/'}>Більше про підхід ↗</a></div></section>
 <section class="cl-section cl-section--mint" id="calculate"><div class="cl-wrap cl-calc-layout"><div class="cl-calc-layout__intro cl-reveal"><span class="cl-kicker">ІНТЕРАКТИВНИЙ КАЛЬКУЛЯТОР</span><h2>Плани на чистоту?<br/><em>Почнімо з цифр.</em></h2><p>Налаштуйте прибирання під себе. Ціна змінюється одразу: без реєстрації, дзвінків і прихованої математики.</p><div class="cl-calc-layout__visual"><img src={photos.kitchen} alt="Чиста мінімалістична кухня" loading="lazy"/><span>Трохи більше простору для себе ↗</span></div></div><Calculator /></div></section>
 <section class="cl-section"><div class="cl-wrap"><div class="cl-section-heading cl-reveal"><div><span class="cl-kicker">КРОК ЗА КРОКОМ</span><h2>Від плану до<br/><em>приємного «готово».</em></h2></div><a class="cl-link" href={base+'booking/'}>Перейти до запису ↗</a></div><div class="cl-steps">{[['01','Оберіть послугу','Визначте формат та площу.'],['02','Додайте деталі','Оберіть додаткові опції.'],['03','Залиште заявку','Вкажіть зручні дату й час.'],['04','Насолоджуйтеся','У демо отримаєте підтвердження без відправлення.']].map(([n,t,d])=><div class="cl-step cl-reveal"><span>{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section>
 <section class="cl-section cl-faq-preview"><div class="cl-wrap cl-faq-grid"><div class="cl-reveal"><span class="cl-kicker">ЧАСТІ ЗАПИТАННЯ</span><h2>Все ясно.<br/><em>Ще до початку.</em></h2><p>Тут зібрано відповіді на питання, які виникають перед замовленням клінінгу.</p><a class="cl-link" href={base+'contacts/'}>Зв'язатися ↗</a></div><div class="cl-accordion">{faqs.slice(0,4).map(([q,a],i)=><details class="cl-reveal"><summary><span>0{i+1} / {q}</span><b>+</b></summary><p>{a}</p></details>)}</div></div></section>
 <section class="cl-end"><div class="cl-wrap cl-end__inner"><span class="cl-kicker">LUMA / MAKE ROOM FOR LIFE</span><h2>Чистіше вдома.<br/><em>Вільніше в голові.</em></h2><p>Знайдіть свій ідеальний формат прибирання за кілька кліків.</p><a class="cl-button cl-button--light" href={base+'booking/'}>Створити демо-заявку ↗</a></div></section>
</Layout>
