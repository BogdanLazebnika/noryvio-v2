---
import Layout from '../../../components/demos/commerce/ShopLayout.astro';import {products,shopBase as base} from '../../../data/commerce';
---
<Layout title="Кошик"><section class="fo-page-hero"><div class="fo-wrap"><span class="fo-kicker">YOUR BAG / DEMO CHECKOUT</span><h1>Ваш <em>кошик.</em></h1><p>Змінюйте кількість товарів і переглядайте підсумок. Це реальна інтерактивність інтерфейсу без реальної оплати.</p></div></section><section class="fo-section"><div class="fo-wrap fo-cart-layout"><div><div class="fo-cart-list" id="fo-cart-list"></div><p class="fo-no-results" id="fo-cart-empty" hidden>Кошик порожній. <a href={base+'catalog/'}>Повернутися до каталогу ↗</a></p></div><aside class="fo-cart-summary"><span class="fo-kicker">ORDER SUMMARY</span><h2>Підсумок</h2><div class="fo-sum-row"><span>Товари</span><strong id="fo-cart-subtotal">0 ₴</strong></div><div class="fo-sum-row"><span>Доставка</span><span>Не розраховується у демо</span></div><div class="fo-sum-total"><span>Разом</span><strong id="fo-cart-total">0 ₴</strong></div><a class="fo-btn" href={base+'checkout/'} id="fo-cart-next">Далі до оформлення ↗</a><p>Ціни орієнтовні. Платіжні дані не запитуються.</p></aside></div></section><script is:inline define:vars={{products}}>document.addEventListener('DOMContentLoaded',()=>{const root=document.getElementById('fo-cart-list'),money=n=>n.toLocaleString('uk-UA')+' ₴';function render(){root.replaceChildren();const cart=window.foShop.readCart();let total=0;const items=products.filter(p=>cart[p.id]>0);items.forEach(p=>{let qty=Math.min(50,Math.max(1,Number(cart[p.id])||1));total+=p.price*qty;const row=document.createElement('div');row.className='fo-cart-row';const img=document.createElement('img');img.src=p.photo;img.alt=p.name;const info=document.createElement('div');const name=document.createElement('h3');name.textContent=p.name;const price=document.createElement('span');price.textContent=money(p.price);const ctr=document.createElement('div');ctr.className='fo-qty';const minus=document.createElement('button');minus.textContent='−';minus.setAttribute('aria-label','Зменшити кількість');minus.addEventListener('click',()=>window.foShop.set(p.id,qty-1));const num=document.createElement('span');num.textContent=qty;const plus=document.createElement('button');plus.textContent='+';plus.setAttribute('aria-label','Збільшити кількість');plus.addEventListener('click',()=>window.foShop.set(p.id,qty+1));ctr.append(minus,num,plus);info.append(name,price,ctr);const sum=document.createElement('strong');sum.textContent=money(p.price*qty);row.append(img,info,sum);root.append(row)});document.getElementById('fo-cart-empty').hidden=items.length!==0;document.getElementById('fo-cart-subtotal').textContent=money(total);document.getElementById('fo-cart-total').textContent=money(total);const next=document.getElementById('fo-cart-next');next.setAttribute('aria-disabled',String(!items.length));next.classList.toggle('fo-disabled',!items.length)}window.addEventListener('fo-cart-changed',render);render()});</script></Layout>
