---
import Layout from '../../../components/demos/commerce/ShopLayout.astro';import Product from '../../../components/demos/commerce/ProductCard.astro';import {products} from '../../../data/commerce';
---
<Layout title="Каталог товарів" active="catalog/"><section class="fo-page-hero"><div class="fo-wrap"><span class="fo-kicker">THE COMPLETE EDIT</span><h1>Каталог <em>об'єктів.</em></h1><p>12 позицій для роботи, музики й щоденного життя. Знаходьте речі через пошук, категорії та сортування.</p></div></section><section class="fo-section"><div class="fo-wrap"><div class="fo-filter-panel"><label class="fo-search">Пошук<input id="fo-search" type="search" autocomplete="off" placeholder="Назва товару..."/></label><label>Категорія<select id="fo-category"><option value="all">Усі категорії</option>{['Аудіо','Гаджети','Дім','Аксесуари'].map(c=><option value={c}>{c}</option>)}</select></label><label>Сортування<select id="fo-sort"><option value="popular">Рекомендовані</option><option value="cheap">Від дешевих</option><option value="expensive">Від дорогих</option><option value="alpha">За назвою</option></select></label></div><p class="fo-count" id="fo-result-count" role="status">12 продуктів</p><div class="fo-product-grid" id="fo-catalog">{products.map(p=><Product p={p}/>)}</div><div id="fo-no-results" class="fo-no-results" hidden>За цими параметрами нічого не знайдено. Спробуйте інший запит.</div></div></section><script is:inline>(()=>{const search=document.getElementById('fo-search'),cat=document.getElementById('fo-category'),sort=document.getElementById('fo-sort'),grid=document.getElementById('fo-catalog'),cards=[...grid.querySelectorAll('.fo-product')];const wanted=new URLSearchParams(location.search).get('category');if(wanted&&[...cat.options].some(x=>x.value===wanted))cat.value=wanted;function update(){const q=search.value.trim().toLowerCase();let visible=cards.filter(p=>{const ok=(cat.value==='all'||p.dataset.foCat===cat.value)&&p.dataset.foTitle.includes(q);p.hidden=!ok;return ok});if(sort.value==='cheap')visible.sort((a,b)=>+a.dataset.foPrice- +b.dataset.foPrice);if(sort.value==='expensive')visible.sort((a,b)=>+b.dataset.foPrice- +a.dataset.foPrice);if(sort.value==='alpha')visible.sort((a,b)=>a.dataset.foTitle.localeCompare(b.dataset.foTitle,'uk'));visible.forEach(p=>grid.appendChild(p));document.getElementById('fo-result-count').textContent=visible.length+' продуктів';document.getElementById('fo-no-results').hidden=!!visible.length}search.addEventListener('input',update);cat.addEventListener('change',update);sort.addEventListener('change',update);update()})();</script></Layout>
