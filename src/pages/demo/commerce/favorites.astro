---
import Layout from '../../../components/demos/commerce/ShopLayout.astro';import {products} from '../../../data/commerce';
---
<Layout title="Обране"><section class="fo-page-hero"><div class="fo-wrap"><span class="fo-kicker">YOUR SELECTION</span><h1>Список <em>бажань.</em></h1><p>Збережені товари залишаються в браузері. Перегляньте їх і додайте до кошика.</p></div></section><section class="fo-section"><div class="fo-wrap"><div id="fo-fav-list" class="fo-product-grid"></div><p id="fo-fav-empty" class="fo-no-results">Поки нічого не додано. <a href="/demo/commerce/catalog/">Перейти до каталогу ↗</a></p></div></section><script is:inline define:vars={{products}}>document.addEventListener('DOMContentLoaded',()=>{const root=document.getElementById('fo-fav-list'),favs=window.foShop.readFav(),items=products.filter(p=>favs[p.id]);document.getElementById('fo-fav-empty').hidden=items.length>0;items.forEach(p=>{const card=document.createElement('article');card.className='fo-fav-card';const a=document.createElement('a');a.href='/demo/commerce/product/'+encodeURIComponent(p.id)+'/';const img=document.createElement('img');img.src=p.photo;img.alt=p.name;img.loading='lazy';a.append(img);const h=document.createElement('h3');h.textContent=p.name;const price=document.createElement('p');price.textContent=p.price.toLocaleString('uk-UA')+' ₴';const btn=document.createElement('button');btn.textContent='Додати в кошик ↗';btn.addEventListener('click',()=>window.foShop.add(p.id));const rm=document.createElement('button');rm.textContent='Прибрати з обраного';rm.addEventListener('click',()=>{window.foShop.toggle(p.id);card.remove();if(!root.childElementCount)document.getElementById('fo-fav-empty').hidden=false});card.append(a,h,price,btn,rm);root.append(card)})});</script></Layout>
