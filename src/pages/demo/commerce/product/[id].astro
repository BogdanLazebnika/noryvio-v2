---
import Layout from '../../../../components/demos/commerce/ShopLayout.astro';import Product from '../../../../components/demos/commerce/ProductCard.astro';import {products,shopBase as base} from '../../../../data/commerce';
export function getStaticPaths(){return products.map(p=>({params:{id:p.id},props:{item:p}}))}
interface Props{item:typeof products[number]}
const {item}=Astro.props;
const related=products.filter(p=>p.id!==item.id&&p.cat===item.cat).slice(0,3);
---
<Layout title={item.name}><section class="fo-section"><div class="fo-wrap"><nav class="fo-breadcrumb"><a href={base}>Головна</a> / <a href={base+'catalog/'}>Каталог</a> / {item.name}</nav><div class="fo-detail-grid"><div class="fo-detail-image"><img src={item.photo} alt={`Фотографія ${item.name}`} fetchpriority="high"/></div><div class="fo-detail-copy"><span class="fo-kicker">FORM / {item.cat.toUpperCase()}</span><h1>{item.name}</h1><p>{item.desc}</p><div class="fo-detail-price">{item.price.toLocaleString('uk-UA')} ₴ {item.old>0&&<del>{item.old.toLocaleString('uk-UA')} ₴</del>}</div><div class="fo-detail-actions"><button class="fo-btn" data-add={item.id} type="button">Додати в кошик ↗</button><button class="fo-detail-like" type="button" data-favorite={item.id} aria-label="Додати в обране">♡</button></div><div class="fo-detail-points"><div>✳ Мінімалістичний дизайн</div><div>✳ Продумана функціональність</div><div>✳ Демонстраційна ціна</div></div><details><summary>Опис та характеристики</summary><p>{item.desc} Точні характеристики, гарантія та наявність у комерційному сайті вказуються згідно з реальним товаром.</p></details><details><summary>Доставка та оплата</summary><p>Демонстраційний магазин: оплата не проводиться і доставка не виконується.</p></details></div></div></div></section><section class="fo-section fo-dark-surface"><div class="fo-wrap"><div class="fo-heading"><h2>Вам може <em>сподобатись.</em></h2><a class="fo-text-link" href={base+'catalog/'}>Усі товари ↗</a></div><div class="fo-product-grid">{related.length?related.map(p=><Product p={p}/>):products.slice(0,3).map(p=><Product p={p}/>)}</div></div></section></Layout>
