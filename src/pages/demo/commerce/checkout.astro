---
import Layout from '../../../components/demos/commerce/ShopLayout.astro';import {products,shopBase as base} from '../../../data/commerce';
---
<Layout title="Демонстраційне оформлення"><section class="fo-page-hero"><div class="fo-wrap"><span class="fo-kicker">SECURE DEMO / NO PAYMENTS</span><h1>Оформлення <em>замовлення.</em></h1><p>Пройдіть сценарій оформлення без банківських даних і справжньої оплати. Введені дані нікуди не передаються.</p></div></section><section class="fo-section"><div class="fo-wrap fo-checkout-layout"><form id="fo-checkout-form" class="fo-checkout-form"><div class="fo-checkout-section"><span class="fo-kicker">01 / CONTACT DETAILS</span><h2>Контактна інформація</h2><div class="fo-fields"><label>Ім’я<input name="name" required minlength="2" maxlength="70" autocomplete="off" placeholder="Ваше ім’я"/></label><label>Телефон<input type="tel" name="phone" required autocomplete="off" pattern="[+0-9()\s-]{9,20}" placeholder="+380 ..."/></label><label class="fo-full">E-mail<input name="email" type="email" required autocomplete="off" placeholder="email@example.com"/></label></div></div><div class="fo-checkout-section"><span class="fo-kicker">02 / DELIVERY</span><h2>Спосіб доставки</h2><label class="fo-radio"><input type="radio" name="delivery" value="pickup" checked/> Самовивіз із демонстраційного пункту</label><label class="fo-radio"><input type="radio" name="delivery" value="courier"/> Кур'єр (без розрахунку вартості)</label><label>Коментар (необов'язково)<textarea name="comment" maxlength="300" rows="3" placeholder="Ваші побажання"></textarea></label></div><div class="fo-checkout-section"><span class="fo-kicker">03 / DEMO CONFIRMATION</span><label class="fo-radio"><input type="checkbox" required/> Розумію, що це лише демонстрація — товари не відправлять, оплату не приймуть</label><button type="submit" class="fo-btn" id="fo-finish">Сформувати демозамовлення ↗</button><div id="fo-checkout-result" class="fo-checkout-result" role="status" hidden></div></div></form><aside class="fo-cart-summary"><span class="fo-kicker">YOUR ORDER</span><h2>Ваш вибір</h2><div id="fo-order-items"></div><div class="fo-sum-total"><span>Разом</span><strong id="fo-order-total">0 ₴</strong></div><a class="fo-text-link" href={base+'cart/'}>← Змінити кошик</a><p>Жодних платіжних реквізитів ми не збираємо.</p></aside></div></section><script is:inline define:vars={{products}}>document.addEventListener('DOMContentLoaded',()=>{const cart=window.foShop.readCart(),items=products.filter(p=>cart[p.id]>0),root=document.getElementById('fo-order-items'),money=n=>n.toLocaleString('uk-UA')+' ₴';let sum=0;for(const p of items){const qty=cart[p.id];sum+=p.price*qty;const div=document.createElement('div');div.className='fo-sum-row';const a=document.createElement('span');a.textContent=p.name+' × '+qty;const b=document.createElement('strong');b.textContent=money(p.price*qty);div.append(a,b);root.append(div)}document.getElementById('fo-order-total').textContent=money(sum);const form=document.getElementById('fo-checkout-form');if(!items.length){const btn=document.getElementById('fo-finish');btn.disabled=true;const e=document.getElementById('fo-checkout-result');e.textContent='Спочатку додайте товари до кошика.';e.hidden=false}form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity()||!items.length)return;const result=document.getElementById('fo-checkout-result');result.hidden=false;result.textContent='Демонстраційне оформлення завершено! '+items.length+' позицій на '+money(sum)+'. Дані не надіслані, замовлення не існує, оплата не проводилась.';form.querySelector('button[type="submit"]').disabled=true;result.scrollIntoView({behavior:'smooth',block:'nearest'})})});</script></Layout>
