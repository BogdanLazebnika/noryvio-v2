---
import Layout from '../../../components/demos/beauty/BeautyLayout.astro';import {treatments,masters} from '../../../data/beauty';
---
<Layout title="Інтерактивний онлайн-запис"><section class="au-page-hero au-sand"><div class="au-wrap"><span class="au-kicker">YOUR TIME / YOUR RITUAL</span><h1>Запишіться на <em>свій час.</em></h1><p>Оберіть процедуру, майстра, дату і час. Це демонстрація функціоналу: дані не відправляються й бронювання не створюється.</p></div></section><section class="au-section"><div class="au-wrap au-book-grid"><div class="au-book-side"><span class="au-kicker">YOUR PERSONAL MOMENT</span><h2>Догляд починається з <em>вибору.</em></h2><p>У готовому комерційному продукті доступність часу перевіряється через систему салону. Тут показано повний клієнтський сценарій без сервера.</p><div class="au-book-preview">РИТУАЛ · МАЙСТЕР · ДАТА · ЧАС</div></div><form id="au-book-form" class="au-book-form"><div class="au-form-top">AURA / ONLINE BOOKING <span>01—04</span></div><label for="au-service">01 / Процедура</label><select id="au-service" name="service" required><option value="">Виберіть послугу</option>{treatments.map(t=><option value={t.id} data-price={t.price} data-length={t.minutes}>{t.name} · {t.minutes} хв · {t.price} ₴</option>)}</select><label for="au-master">02 / Майстер</label><select id="au-master" name="master" required><option value="">Оберіть майстра</option>{masters.map(m=><option value={m.id}>{m.name} — {m.role}</option>)}</select><label for="au-date">03 / Бажана дата</label><input type="date" name="date" id="au-date" required/><fieldset><legend>04 / Орієнтовний час</legend><div class="au-times" id="au-times">{['10:00','11:30','13:00','14:30','16:00','17:30'].map(t=><label><input type="radio" name="time" value={t} required/><span>{t}</span></label>)}</div></fieldset><label for="au-name">Ваше ім’я</label><input id="au-name" name="name" type="text" placeholder="Як до вас звертатись?" minlength="2" maxlength="70" required/><label for="au-phone">Телефон (лише для демонстрації)</label><input id="au-phone" name="phone" type="tel" autocomplete="off" placeholder="+380 ..." pattern="[+0-9()\s-]{9,20}" required/><p class="au-form-hint">Телефон не надсилатиметься і не зберігатиметься. Для тесту можна ввести вигаданий номер.</p><div class="au-book-sum"><span>Орієнтовна ціна</span><strong id="au-book-price">Оберіть послугу</strong></div><button class="au-btn au-submit" type="submit">Підтвердити демозапис ↗</button><div id="au-book-result" class="au-book-result" role="status" hidden></div></form></div></section>
<script is:inline>(()=>{const form=document.getElementById('au-book-form'),date=form.querySelector('[name="date"]'),sel=form.querySelector('[name="service"]'),price=document.getElementById('au-book-price');const now=new Date(),local=new Date(now.getTime()-now.getTimezoneOffset()*60000).toISOString().slice(0,10);date.min=local;const max=new Date(now);max.setDate(max.getDate()+45);date.max=new Date(max.getTime()-max.getTimezoneOffset()*60000).toISOString().slice(0,10);const q=new URLSearchParams(location.search);if(q.get('service'))sel.value=q.get('service');if(q.get('master'))form.querySelector('[name="master"]').value=q.get('master');function refresh(){price.textContent=sel.selectedOptions[0]?.dataset.price?Number(sel.selectedOptions[0].dataset.price).toLocaleString('uk-UA')+' ₴':'Оберіть послугу'}sel.addEventListener('change',refresh);refresh();form.addEventListener('submit',e=>{e.preventDefault();if(!form.reportValidity())return;const d=new FormData(form),service=sel.selectedOptions[0].textContent.split(' ·')[0],master=form.querySelector('[name="master"]').selectedOptions[0].textContent.split(' —')[0];const el=document.getElementById('au-book-result');el.textContent=`Демозапис сформовано: ${service}; майстер ${master}; ${d.get('date')} о ${d.get('time')}. Це локальне підтвердження — реального бронювання немає, дані не відправлено.`;el.hidden=false;el.scrollIntoView({behavior:'smooth',block:'nearest'})})})();</script></Layout>
