---
import Layout from '../../../components/demos/beauty/BeautyLayout.astro';
import Card from '../../../components/demos/beauty/BeautyCard.astro';
import {beautyPhotos as pic,treatments,masters,beautyBase as base} from '../../../data/beauty';
---
<Layout title="Мистецтво бути собою" active=""><section class="au-hero"><div class="au-hero-photo"><img src={pic.hero} alt="Атмосфера салону краси з теплим світлом" fetchpriority="high"/></div><div class="au-wrap au-hero-inner"><div class="au-hero-copy au-reveal"><div class="au-eyebrow">BEAUTY · MINDFULNESS · YOU</div><h1>Твоя краса.<br/><em>Твій ритм.</em></h1><p>Місце, де турбота стає ритуалом. Делікатні процедури, професійний погляд і час тільки для себе.</p><div class="au-actions"><a class="au-btn" href={base+'booking/'}>Записатись на процедуру ↗</a><a class="au-link-light" href={base+'services/'}>Дослідити послуги →</a></div></div><span class="au-hero-side">AURA / FEEL YOURSELF</span></div><div class="au-hero-bottom"><div class="au-wrap"><span>01 — КРАСА БЕЗ ПОСПІХУ</span><span>ГОРТАЙТЕ ВНИЗ ↓</span></div></div></section>
<section class="au-intro au-section"><div class="au-wrap au-intro-grid"><div class="au-reveal"><span class="au-kicker">НАША ФІЛОСОФІЯ</span><h2>Менше шуму.<br/><em>Більше тебе.</em></h2></div><div class="au-reveal"><p class="au-big-lead">Не просто салон. Простір, у якому можна відпустити щоденний ритм і довіритися професіоналам.</p><a class="au-underlink" href={base+'masters/'}>Познайомитися з командою ↗</a></div></div></section>
<section class="au-section au-sand"><div class="au-wrap"><div class="au-heading"><div><span class="au-kicker">01 / OUR RITUALS</span><h2>Улюблені <em>ритуали.</em></h2></div><a class="au-underlink" href={base+'services/'}>Усі послуги ↗</a></div><div class="au-cards">{treatments.slice(0,4).map(item=><Card item={item}/>)}</div></div></section>
<section class="au-story"><div class="au-story-image"><img src={pic.interior} alt="Світлий затишний інтер'єр beauty студії" loading="lazy"/></div><div class="au-story-copy"><span class="au-kicker">02 / THE SPACE</span><h2>Атмосфера,<br/><em>яку відчуваєш.</em></h2><p>М’яке світло, натуральні текстури, продуманий простір. У AURA усе створено для комфортного досвіду — від першої хвилини до фінального штриха.</p><a class="au-underlink" href={base+'gallery/'}>Прогулятися галереєю ↗</a></div></section>
<section class="au-section"><div class="au-wrap"><div class="au-heading"><div><span class="au-kicker">03 / PEOPLE BEHIND THE MAGIC</span><h2>Руки, яким <em>довіряють.</em></h2></div><a class="au-underlink" href={base+'masters/'}>Наша команда ↗</a></div><div class="au-team-grid">{masters.map(m=><article class="au-team-card au-reveal"><img src={m.photo} alt={`Демонстраційний портрет — ${m.name}`} loading="lazy"/><div><h3>{m.name}</h3><p>{m.role}</p></div></article>)}</div></div></section>
<section class="au-cta"><div class="au-wrap au-cta-center"><span class="au-kicker">TIME FOR YOU</span><h2>Час для <em>себе.</em></h2><p>Обери ритуал, майстра та зручний час. Спробуй інтерактивний запис просто зараз.</p><a class="au-btn" href={base+'booking/'}>Вибрати час ↗</a><small>Демо: бронювання не передається жодному салону.</small></div></section></Layout>
