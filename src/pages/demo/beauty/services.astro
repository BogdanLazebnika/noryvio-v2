---
import Layout from '../../../components/demos/beauty/BeautyLayout.astro';import Card from '../../../components/demos/beauty/BeautyCard.astro';import {treatments} from '../../../data/beauty';
---
<Layout title="Процедури та послуги" active="services/"><section class="au-page-hero au-sand"><div class="au-wrap"><span class="au-kicker">RITUALS / AURA</span><h1>Послуги, що повертають <em>баланс.</em></h1><p>Вісім процедур для волосся, обличчя, нігтів і відпочинку. Оберіть свою, щоб перейти до запису.</p></div></section><section class="au-section"><div class="au-wrap"><div class="au-filterbar" role="group" aria-label="Категорії послуг"><button class="au-filter-on" data-beauty-filter="Усі" aria-pressed="true">Усі послуги</button>{['Волосся','Обличчя','Нігті','SPA'].map(c=><button data-beauty-filter={c} aria-pressed="false">{c}</button>)}</div><div class="au-cards au-cards-services" id="au-treatments">{treatments.map(item=><div data-beauty-cat={item.category}><Card item={item}/></div>)}</div></div></section><script is:inline>document.querySelectorAll('[data-beauty-filter]').forEach(btn=>btn.addEventListener('click',()=>{const c=btn.dataset.beautyFilter;document.querySelectorAll('[data-beauty-filter]').forEach(b=>{b.classList.toggle('au-filter-on',b===btn);b.setAttribute('aria-pressed',String(b===btn))});document.querySelectorAll('[data-beauty-cat]').forEach(card=>card.hidden=c!=='Усі'&&card.dataset.beautyCat!==c)}));</script></Layout>
