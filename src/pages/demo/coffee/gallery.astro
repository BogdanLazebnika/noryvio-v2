---
import CoffeeLayout from '../../../components/demos/coffee/CoffeeLayout.astro';
import { photo } from '../../../data/coffeeMenu';
const pics=[['Кавова пауза',photo.coffee,'Кава'],['Простір для розмов',photo.interior,'Простір'],['Круасан із ранковою кавою',photo.croissant,'Їжа'],['Свіже зерно',photo.beans,'Кава'],['Лате-арт',photo.latte,'Кава'],['Наша атмосфера',photo.counter,'Простір'],['Солодке до кави',photo.cheesecake,'Їжа'],['Сніданок',photo.breakfast,'Їжа'],['Момент тиші',photo.tea,'Кава']];
---
<CoffeeLayout title="Галерея" active="/gallery/">
<section class="coffee-page-hero" style={`--page-image:url('${photo.counter}')`}><div class="coffee-container"><span class="coffee-eyebrow">BREW & BLOOM / АТМОСФЕРА</span><h1>Моменти,<br/><em>які залишаються.</em></h1><p>Усе, заради чого хочеться повернутися. Концептуальна фотогалерея.</p></div></section>
<section class="coffee-section coffee-section--cream"><div class="coffee-container"><div class="coffee-filter-pills coffee-gallery-filters" role="group" aria-label="Фільтр галереї">{['Усе','Кава','Простір','Їжа'].map((t,i)=><button type="button" class:list={{'is-active':i===0}} data-gallery-filter={t} aria-pressed={i===0}>{t}</button>)}</div><div class="coffee-gallery-grid" id="coffee-gallery-grid">{pics.map(([title,src,category],i)=><button class="coffee-gallery-tile" type="button" data-gallery-category={category} data-gallery-src={src} data-gallery-alt={title} aria-label={`Збільшити фото: ${title}`}><img src={src} alt={title} loading="lazy"/><span>{title} <b>↗</b></span></button>)}</div></div></section>
<dialog class="coffee-lightbox" id="coffee-lightbox" aria-label="Перегляд фото"><div class="coffee-lightbox__content"><button type="button" class="coffee-lightbox__close" aria-label="Закрити перегляд">✕</button><img id="coffee-lightbox-img" src="" alt=""/><p id="coffee-lightbox-caption"></p></div></dialog>
<script is:inline>
(()=>{const filters=[...document.querySelectorAll('[data-gallery-filter]')],tiles=[...document.querySelectorAll('.coffee-gallery-tile')],dialog=document.querySelector('#coffee-lightbox'),img=document.querySelector('#coffee-lightbox-img'),caption=document.querySelector('#coffee-lightbox-caption');filters.forEach(b=>b.addEventListener('click',()=>{filters.forEach(x=>{x.classList.toggle('is-active',x===b);x.setAttribute('aria-pressed',String(x===b))});tiles.forEach(t=>t.hidden=b.dataset.galleryFilter!=='Усе'&&t.dataset.galleryCategory!==b.dataset.galleryFilter)}));tiles.forEach(t=>t.addEventListener('click',()=>{img.src=t.dataset.gallerySrc;img.alt=t.dataset.galleryAlt;caption.textContent=t.dataset.galleryAlt;dialog.showModal()}));dialog.querySelector('.coffee-lightbox__close').addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()})})();
</script>
</CoffeeLayout>
