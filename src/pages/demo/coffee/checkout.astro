---
import CoffeeLayout from '../../../components/demos/coffee/CoffeeLayout.astro';
import { menu } from '../../../data/coffeeMenu';
---
<CoffeeLayout title="Кошик та демозамовлення">
<section class="coffee-page-hero coffee-page-hero--short"><div class="coffee-container"><span class="coffee-eyebrow">BREW & BLOOM / ВАШ ВИБІР</span><h1>Мій <em>кошик.</em></h1><p>Складайте замовлення як на реальному сайті. Без оплати й передавання даних.</p></div></section>
<section class="coffee-section coffee-section--cream"><div class="coffee-container coffee-checkout-layout"><div class="coffee-checkout-items"><div class="coffee-checkout-head"><h2>Обрані позиції</h2><a href="/demo/coffee/menu/">← Продовжити вибір</a></div><div id="coffee-checkout-list" aria-live="polite"></div><div class="coffee-checkout-empty" id="coffee-checkout-empty" hidden><h3>Тут поки порожньо</h3><p>Зазирни до меню — там знайдеться щось смачне.</p><a class="coffee-btn coffee-btn--dark" href="/demo/coffee/menu/">До меню ↗</a></div></div><aside class="coffee-checkout-summary"><span class="coffee-eyebrow">ПІДСУМОК</span><h2>Ваше замовлення</h2><div class="coffee-checkout-summary__line"><span>Товари</span><b id="coffee-checkout-subtotal">0 ₴</b></div><div class="coffee-checkout-summary__line"><span>Сервіс / доставка</span><span>Не застосовується</span></div><div class="coffee-checkout-summary__total"><span>Разом</span><strong id="coffee-checkout-total">0 ₴</strong></div><p>Демонстраційне замовлення: нічого не оплачується та не передається продавцю.</p><form id="coffee-checkout-form"><label>Ім’я <input name="name" autocomplete="given-name" minlength="2" maxlength="50" placeholder="Як до вас звертатися" required/></label><label>Телефон <input name="phone" type="tel" autocomplete="tel" pattern="[+0-9()\s-]{9,20}" placeholder="+380 XX XXX XX XX" required/></label><label>Формат <select name="method" required><option value="Самовивіз">Самовивіз (демо)</option><option value="У закладі">У закладі (демо)</option></select></label><label class="coffee-consent"><input type="checkbox" required/><span>Розумію, що замовлення демонстраційне й не буде надіслано.</span></label><button class="coffee-btn coffee-btn--dark" id="coffee-checkout-submit" type="submit">Оформити демозамовлення ↗</button></form><div id="coffee-checkout-confirmation" class="coffee-booking-success" hidden role="status"><div>✓</div><h3>Демо готове!</h3><p id="coffee-order-info"></p><p>Дані не надіслані, кошик очищений. Гроші не списувалися.</p><a class="coffee-btn coffee-btn--dark" href="/demo/coffee/menu/">Повернутись до меню ↗</a></div></aside></div></section>
<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const data=JSON.parse(document.querySelector('#coffee-menu-json').textContent),cart=window.CoffeeDemoCart,fmt=n=>`${n.toLocaleString('uk-UA')} ₴`,list=document.querySelector('#coffee-checkout-list'),empty=document.querySelector('#coffee-checkout-empty'),form=document.querySelector('#coffee-checkout-form'),submit=document.querySelector('#coffee-checkout-submit'),confirmation=document.querySelector('#coffee-checkout-confirmation');let sum=0;function draw(){const state=cart.read();sum=0;list.replaceChildren();for(const [id,count] of Object.entries(state)){const item=data.find(x=>x.id===id);if(!item||!Number.isFinite(Number(count))||Number(count)<=0)continue;sum+=item.price*count;const row=document.createElement('div');row.className='coffee-cart-row';const image=document.createElement('img');image.src=item.image;image.alt='';image.loading='lazy';const details=document.createElement('div');details.className='coffee-cart-row__info';const title=document.createElement('h3');title.textContent=item.name;const price=document.createElement('p');price.textContent=fmt(item.price);const quantity=document.createElement('div');quantity.className='coffee-quantity';const minus=document.createElement('button');minus.type='button';minus.textContent='−';minus.setAttribute('aria-label',`Зменшити ${item.name}`);minus.addEventListener('click',()=>cart.change(id,-1));const val=document.createElement('span');val.textContent=String(count);const plus=document.createElement('button');plus.type='button';plus.textContent='+';plus.setAttribute('aria-label',`Додати ${item.name}`);plus.addEventListener('click',()=>cart.change(id,1));quantity.append(minus,val,plus);details.append(title,price,quantity);const total=document.createElement('strong');total.textContent=fmt(item.price*count);row.append(image,details,total);list.append(row)}empty.hidden=list.childElementCount>0;document.querySelector('#coffee-checkout-subtotal').textContent=fmt(sum);document.querySelector('#coffee-checkout-total').textContent=fmt(sum);submit.disabled=sum===0;document.querySelector('#coffee-checkout-form').hidden=sum===0||!confirmation.hidden}window.addEventListener('coffee-cart-changed',draw);draw();form.addEventListener('submit',e=>{e.preventDefault();if(sum<=0)return;if(!form.reportValidity())return;const d=new FormData(form);document.querySelector('#coffee-order-info').textContent=`${d.get('name')}, ваш демонстраційний підсумок: ${fmt(sum)} · ${d.get('method')}.`;confirmation.hidden=false;cart.clear();form.hidden=true;confirmation.scrollIntoView({behavior:'smooth',block:'center'})})});
</script>
<script type="application/json" id="coffee-menu-json" set:html={JSON.stringify(menu).replace(/</g, '\\u003c')} />
</CoffeeLayout>
