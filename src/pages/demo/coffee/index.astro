---
import CoffeeLayout from '../../../components/demos/coffee/CoffeeLayout.astro';
import { menu, money, photo } from '../../../data/coffeeMenu';
const featured=menu.filter(x=>x.popular).slice(0,4);
const base='/demo/coffee';
---
<CoffeeLayout title="Кава, простір, натхнення" active="/" description="Демонстраційна багатосторінкова кав’ярня з меню, кошиком та бронюванням.">
  <section class="coffee-hero" style={`--hero-image:url('${photo.hero}')`}>
    <div class="coffee-hero__noise" aria-hidden="true"></div><div class="coffee-container coffee-hero__content">
      <div class="coffee-eyebrow coffee-hero__eyebrow"><span class="coffee-dot"></span> SPECIALTY COFFEE · YOUR DAILY RITUAL</div>
      <h1>Добра кава.<br /><em>Добрі моменти.</em></h1>
      <p>Місце, де аромат свіжозмелених зерен зустрічається з неспішними розмовами. Заходьте за кавою. Залишайтеся за відчуттям.</p>
      <div class="coffee-hero__buttons"><a class="coffee-btn coffee-btn--gold" href={base+'/menu/'}>Дослідити меню <span>↗</span></a><a class="coffee-btn coffee-btn--outline" href={base+'/about/'}>Наша історія <span>↗</span></a></div>
      <div class="coffee-hero__bottom"><span>01 / 05 — BREW & BLOOM</span><span>SCROLL TO EXPLORE ↓</span></div>
    </div>
    <div class="coffee-hero__vertical" aria-hidden="true">TAKE A MOMENT. STAY A WHILE.</div>
  </section>
  <section class="coffee-ticker" aria-label="Наші цінності"><div>СВІЖЕ ЗЕРНО <span>✳</span> АТМОСФЕРА <span>✳</span> СЕЗОННЕ МЕНЮ <span>✳</span> ТУРБОТА У ДЕТАЛЯХ <span>✳</span> СВІЖЕ ЗЕРНО <span>✳</span> АТМОСФЕРА <span>✳</span></div></section>
  <section class="coffee-section coffee-section--cream"><div class="coffee-container"><div class="coffee-section__head coffee-reveal"><div><span class="coffee-eyebrow">01 / НАШІ УЛЮБЛЕНЦІ</span><h2>Трохи щастя<br/><em>у кожній чашці.</em></h2></div><a class="coffee-text-link" href={base+'/menu/'}>Повне меню <span>↗</span></a></div><div class="coffee-featured-grid">{featured.map((item,i)=><article class="coffee-product coffee-reveal" style={`--delay:${i*80}ms`}><div class="coffee-product__image"><img src={item.image} alt={item.name} loading="lazy" decoding="async"/><span class="coffee-product__tag">{item.badge || 'Улюблене'}</span></div><div class="coffee-product__detail"><span>{item.category}</span><h3>{item.name}</h3><p>{item.desc}</p><div class="coffee-product__bottom"><strong>{money(item.price)}</strong><button class="coffee-add" data-add-id={item.id} aria-label={`Додати ${item.name} до кошика`}>+</button></div></div></article>)}</div></div></section>
  <section class="coffee-story-split"><div class="coffee-story-split__image coffee-reveal"><img src={photo.interior} alt="Затишний інтер’єр кав’ярні" loading="lazy" decoding="async"/><span>GOOD THINGS TAKE TIME.</span></div><div class="coffee-story-split__content coffee-reveal"><span class="coffee-eyebrow">02 / БІЛЬШЕ НІЖ КАВА</span><h2>Тут хочеться<br/><em>затриматись.</em></h2><p>Ми віримо, що улюблені місця народжуються з дрібниць: теплого світла, знайомого смаку й щирого «раді вас бачити».</p><p>Цей сайт — концепт, але кожна його деталь показує, яким живим може бути онлайн-простір реальної кав’ярні.</p><a class="coffee-btn coffee-btn--outline-dark" href={base+'/about/'}>Познайомитися ближче ↗</a><div class="coffee-story-split__line">CRAFTED WITH HEART · SHARED WITH YOU</div></div></section>
  <section class="coffee-section coffee-section--dark"><div class="coffee-container"><div class="coffee-section__head coffee-reveal"><div><span class="coffee-eyebrow">03 / НАШ ПРОСТІР</span><h2>Кожна зустріч<br/><em>має свою історію.</em></h2></div><a class="coffee-text-link coffee-text-link--light" href={base+'/gallery/'}>Подивитися галерею ↗</a></div><div class="coffee-mosaic"><img class="coffee-reveal" src={photo.counter} alt="Кавовий бар" loading="lazy"/><img class="coffee-reveal" src={photo.beans} alt="Добірні кавові зерна" loading="lazy"/><img class="coffee-reveal" src={photo.croissant} alt="Свіжа випічка" loading="lazy"/></div></div></section>
  <section class="coffee-section coffee-section--cream"><div class="coffee-container"><div class="coffee-section__head coffee-reveal"><div><span class="coffee-eyebrow">04 / МОМЕНТИ</span><h2>Завжди є привід<br/><em>зустрітись.</em></h2></div><a class="coffee-text-link" href={base+'/events/'}>Усі події ↗</a></div><div class="coffee-events-home"><article class="coffee-event-panel coffee-reveal"><div class="coffee-event-panel__date">СУБОТА <strong>12:00</strong></div><h3>Знайомство<br/>зі specialty</h3><p>Дегустація зерен із різних регіонів — без складних термінів.</p><a href={base+'/events/'}>Докладніше ↗</a></article><article class="coffee-event-panel coffee-event-panel--light coffee-reveal"><div class="coffee-event-panel__date">НЕДІЛЯ <strong>11:00</strong></div><h3>Повільний<br/>недільний ранок</h3><p>Музика, кава та сніданки. Маленький ритуал для великого настрою.</p><a href={base+'/events/'}>Докладніше ↗</a></article></div></div></section>
  <section class="coffee-final"><div class="coffee-container coffee-final__inner coffee-reveal"><span class="coffee-eyebrow">05 / ЗАХОДЬТЕ НА КАВУ</span><h2>Найкращі історії<br/><em>починаються з кави.</em></h2><p>Обери свій столик, сплануй візит або просто переглянь меню.</p><div><a class="coffee-btn coffee-btn--gold" href={base+'/contacts/#booking'}>Демобронювання ↗</a><a class="coffee-btn coffee-btn--outline" href={base+'/menu/'}>Переглянути меню ↗</a></div></div></section>
</CoffeeLayout>
