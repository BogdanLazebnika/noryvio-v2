---
import CoffeeLayout from '../../../components/demos/coffee/CoffeeLayout.astro';
import { photo } from '../../../data/coffeeMenu';
---
<CoffeeLayout title="Контакти та бронювання" active="/contacts/">
<section class="coffee-page-hero" style={`--page-image:url('${photo.interior}')`}><div class="coffee-container"><span class="coffee-eyebrow">BREW & BLOOM / ЗВ’ЯЗОК</span><h1>Побачимось<br/><em>за кавою.</em></h1><p>Дізнайся, як може виглядати форма бронювання столика на реальному сайті кав’ярні.</p></div></section>
<section class="coffee-section coffee-section--cream"><div class="coffee-container coffee-contact-layout"><div class="coffee-contact-info"><span class="coffee-eyebrow">01 / ІНФОРМАЦІЯ</span><h2>Давай<br/><em>зустрінемось.</em></h2><p>Це демонстраційний заклад. Адреса та години наведені для прикладу — не плануй реальний візит.</p><div class="coffee-contact-info__item"><b>◎</b><div><strong>Адреса</strong><span>Київ, умовна локація (демо)</span></div></div><div class="coffee-contact-info__item"><b>◷</b><div><strong>Графік роботи</strong><span>Щодня, 08:00–21:00 (демо)</span></div></div><div class="coffee-contact-info__item"><b>✉</b><div><strong>Зв'язок</strong><span>Для створення такого сайту — Noryvio</span><a href="/#contacts">Зв’язатися з Noryvio ↗</a></div></div><img class="coffee-contact-info__image" src={photo.counter} alt="Атмосфера кав’ярні" loading="lazy"/></div><div class="coffee-booking" id="booking"><div class="coffee-booking__header"><span class="coffee-eyebrow">02 / ЗАПИС СТОЛИКА</span><h2>Забронюй <em>момент.</em></h2><p>Спробуй форму — підтвердження з’явиться тільки на цьому екрані. Дані нікуди не надсилаються.</p></div><form id="coffee-booking-form"><div class="coffee-form-grid"><label>Ваше ім’я <input name="name" autocomplete="given-name" minlength="2" maxlength="60" placeholder="Олександр" required/></label><label>Телефон <input name="phone" type="tel" autocomplete="tel" pattern="[+0-9()\s-]{9,20}" placeholder="+380 XX XXX XX XX" required/></label><label>Дата <input type="date" name="date" id="coffee-booking-date" required/></label><label>Час <select name="time" required><option value="">Оберіть час</option>{['09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00','18:00','19:00','20:00'].map(x=><option value={x}>{x}</option>)}</select></label><label>Кількість гостей <select name="guests" required>{[1,2,3,4,5,6].map(x=><option value={x} selected={x===2}>{x} {x===1?'гість': x<5?'гості':'гостей'}</option>)}</select></label><label>Привід <select name="occasion"><option value="">Просто кава</option><option value="Зустріч">Зустріч</option><option value="Робота">Робота</option><option value="Свято">Свято</option></select></label></div><label class="coffee-form-wide">Побажання <textarea name="notes" rows="3" maxlength="300" placeholder="За бажанням — наприклад, столик біля вікна"></textarea></label><label class="coffee-consent"><input type="checkbox" required/><span>Розумію, що це демонстраційне бронювання, яке не надсилається реальному закладу.</span></label><button class="coffee-btn coffee-btn--dark coffee-booking__submit" type="submit">Перевірити бронювання ↗</button><p class="coffee-form-error" id="coffee-booking-error" role="alert" hidden></p></form><div class="coffee-booking-success" id="coffee-booking-success" hidden role="status" aria-live="polite"><div>✓</div><h3>Демобронювання готове!</h3><p id="coffee-booking-summary"></p><p>Це лише приклад підтвердження. Запис не збережений і не надісланий.</p><button type="button" class="coffee-btn coffee-btn--dark" id="coffee-booking-again">Заповнити ще раз</button></div></div></div></section>
<script is:inline>
(()=>{const form=document.querySelector('#coffee-booking-form'),date=document.querySelector('#coffee-booking-date'),success=document.querySelector('#coffee-booking-success'),error=document.querySelector('#coffee-booking-error'),summary=document.querySelector('#coffee-booking-summary');const localDate=(d)=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;const today=new Date();date.min=localDate(today);const max=new Date(today);max.setDate(max.getDate()+60);date.max=localDate(max);date.value=localDate(today);form.addEventListener('submit',e=>{e.preventDefault();error.hidden=true;const d=new FormData(form),day=new Date(`${d.get('date')}T12:00:00`);if(!Number.isFinite(day.valueOf())||day<new Date(new Date().setHours(0,0,0,0))){error.hidden=false;error.textContent='Оберіть дату, що ще не минула.';return}if(!form.reportValidity())return;summary.textContent=`${d.get('name')}, ${d.get('date')} о ${d.get('time')}, гостей: ${d.get('guests')}.`;form.hidden=true;success.hidden=false;success.scrollIntoView({behavior:'smooth',block:'center'})});document.querySelector('#coffee-booking-again').addEventListener('click',()=>{form.reset();date.value=localDate(new Date());success.hidden=true;form.hidden=false})})();
</script>
</CoffeeLayout>
