---
import CoffeeLayout from '../../../components/demos/coffee/CoffeeLayout.astro';
import { menu, money, photo } from '../../../data/coffeeMenu';
const categories=['Усе меню','Кава','Авторські напої','Чай','Сніданки','Десерти'];
---
<CoffeeLayout title="Меню" active="/menu/" description="Інтерактивне меню демонстраційної кав’ярні: пошук, фільтри, сортування й кошик.">
<section class="coffee-page-hero coffee-page-hero--menu" style={`--page-image:url('${photo.beans}')`}><div class="coffee-container"><span class="coffee-eyebrow">BREW & BLOOM / ОБИРАЙ СВОЄ</span><h1>Наше <em>меню.</em></h1><p>Від ранкового еспресо до неспішного десерту. Досліджуй смаки та складай власне демозамовлення.</p></div></section>
<section class="coffee-section coffee-section--cream coffee-menu-section"><div class="coffee-container"><div class="coffee-menu-toolbar"><div class="coffee-filter-pills" role="group" aria-label="Категорії меню">{categories.map((cat,i)=><button type="button" class:list={{'is-active':i===0}} data-filter={cat} aria-pressed={i===0}>{cat}</button>)}</div><div class="coffee-menu-utility"><label class="coffee-search"><span aria-hidden="true">⌕</span><input id="coffee-search" type="search" placeholder="Знайти у меню..." aria-label="Пошук за назвою або описом"/></label><label class="coffee-sort-label">Сортування <select id="coffee-sort" aria-label="Сортування меню"><option value="default">За замовчуванням</option><option value="price-asc">Спершу дешевші</option><option value="price-desc">Спершу дорожчі</option><option value="name">За назвою</option></select></label></div></div><p class="coffee-results" id="coffee-results" role="status">Показано {menu.length} позицій</p><div class="coffee-menu-grid" id="coffee-menu-grid">{menu.map((item,i)=><article class="coffee-product coffee-menu-product" data-category={item.category} data-name={`${item.name} ${item.desc}`.toLowerCase()} data-price={item.price} data-index={i} data-title={item.name}><div class="coffee-product__image"><img src={item.image} alt={item.name} loading="lazy" decoding="async"/><span class="coffee-product__tag">{item.badge||item.category}</span></div><div class="coffee-product__detail"><span>{item.category}{item.vegan?' · 🌿':''}</span><h2>{item.name}</h2><p>{item.desc}</p><div class="coffee-product__bottom"><strong>{money(item.price)}</strong><button class="coffee-add" data-add-id={item.id} aria-label={`Додати ${item.name} до кошика`}>+</button></div></div></article>)}</div><div class="coffee-empty" id="coffee-no-results" hidden><h2>Нічого не знайшли</h2><p>Спробуй інший запит або обери іншу категорію.</p><button class="coffee-btn coffee-btn--dark" id="coffee-reset">Показати все</button></div></div></section>
<div class="coffee-cart-float"><a href="/demo/coffee/checkout/">Перейти в кошик <span data-cart-count>0</span> ↗</a></div>
<script is:inline>
(()=>{let current='Усе меню';const grid=document.querySelector('#coffee-menu-grid'), cards=[...grid.querySelectorAll('.coffee-menu-product')], search=document.querySelector('#coffee-search'),sort=document.querySelector('#coffee-sort'),count=document.querySelector('#coffee-results'),empty=document.querySelector('#coffee-no-results'),pills=[...document.querySelectorAll('[data-filter]')];function update(){let q=search.value.trim().toLocaleLowerCase('uk'),n=0;cards.forEach(card=>{const show=(current==='Усе меню'||card.dataset.category===current)&&card.dataset.name.includes(q);card.hidden=!show;if(show)n++});const visible=cards.filter(x=>!x.hidden);visible.sort((a,b)=>{if(sort.value==='price-asc')return +a.dataset.price- +b.dataset.price;if(sort.value==='price-desc')return +b.dataset.price- +a.dataset.price;if(sort.value==='name')return a.dataset.title.localeCompare(b.dataset.title,'uk');return +a.dataset.index- +b.dataset.index}).forEach(x=>grid.append(x));count.textContent=`Показано ${n} із ${cards.length} позицій`;empty.hidden=n>0}pills.forEach(b=>b.addEventListener('click',()=>{current=b.dataset.filter;pills.forEach(x=>{const on=x===b;x.classList.toggle('is-active',on);x.setAttribute('aria-pressed',String(on))});update()}));search.addEventListener('input',update);sort.addEventListener('change',update);document.querySelector('#coffee-reset').addEventListener('click',()=>{search.value='';pills[0].click()});update()})();
</script>
</CoffeeLayout>
