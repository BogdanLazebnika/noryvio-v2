---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/legal.css";

const sections = [
  { id: "operator", title: "Володілець персональних даних", number: "01", content: "<p>Володілець персональних даних, які надходять через сайт Noryvio, — <strong>Лазебник Богдан Леонідович</strong>, фізична особа, Україна, м. Київ. Noryvio — назва проєкту, а не окрема юридична особа чи зареєстрований на цей момент ФОП.</p><p>Для звернень щодо персональних даних: <a href=\"mailto:noryvio.dev@gmail.com\">noryvio.dev@gmail.com</a>. Контактний телефон: <a href=\"tel:+380683296960\">+380683296960</a>.</p>" },
  { id: "data", title: "Яку інформацію збираємо", number: "02", content: "<p>Через форму заявки: ім’я, номер телефону, email (за наявності), Telegram-ім’я (за наявності), зручний спосіб зв’язку, вибраний тип сайту, опис завдання та факт погодження з політикою. Технічне поле захисту від спаму може оброблятися без показу користувачу.</p><p>Під час звернення до сайту та проходження Cloudflare Turnstile можуть оброблятися технічні відомості (зокрема IP-адреса, параметри браузера й результати антибот-перевірки) за правилами відповідних сервісів. Не надсилайте паролі, платіжні реквізити, документи чи спеціальні категорії персональних даних через форму.</p>" },
  { id: "purpose", title: "Для чого потрібні дані", number: "03", content: "<p>Для отримання та обробки звернень, зв’язку з вами, уточнення потреб, підготовки пропозиції та — якщо ви погодитеся — подальшого укладення договору. Технічні дані також використовуються для протидії спаму та захисту форми.</p><p>Правові підстави можуть включати вашу згоду, необхідність дій до укладення договору за вашим зверненням і законний інтерес у безпеці сервісу — залежно від конкретної операції та вимог законодавства. Ми не обіцяємо рекламні розсилки як частину подання заявки та не включаємо згоду на маркетинг автоматично.</p>" },
  { id: "services", title: "Кому передаються дані", number: "04", content: "<p>Форма працює через інфраструктуру <strong>Cloudflare Pages / Workers / Turnstile</strong>; повідомлення про заявку передається через <strong>Telegram Bot API</strong> до налаштованого чату власника проєкту. Для зв’язку з вами може використовуватися зазначений вами телефон, email або Telegram.</p><p>Cloudflare та Telegram можуть обробляти інформацію на серверах за межами України відповідно до власних умов і політик. Не передаємо заявки третім особам з метою продажу бази контактів. Якщо фактичний склад сервісів зміниться, політику необхідно оновити.</p>" },
  { id: "retention", title: "Строк зберігання та видалення", number: "05", content: "<p><strong>Звернення, які не привели до укладення договору, зберігаємо не довше 90 календарних днів від останнього змістовного контакту</strong>, після чого видаляємо їх із доступних нам робочих чатів, повідомлень та облікових записів, за винятком даних, які обов’язково потрібно зберігати за законом або для обґрунтованого захисту прав.</p><p>Якщо укладено договір, дані, необхідні для його виконання, бухгалтерського обліку та захисту прав, можуть зберігатися протягом передбачених законом строків. Технічні журнали та інформація у сторонніх сервісах можуть мати власні строки зберігання, які визначають ці постачальники.</p>" },
  { id: "rights", title: "Ваші права", number: "06", content: "<p>Ви можете отримати інформацію про обробку своїх даних, запитати доступ, виправлення, видалення у випадках, передбачених законом, обмежити неправомірну обробку, відкликати згоду, коли вона є підставою обробки, та звернутися за захистом до Уповноваженого Верховної Ради України з прав людини чи до суду.</p><p>Для реалізації прав напишіть на <a href=\"mailto:noryvio.dev@gmail.com\">noryvio.dev@gmail.com</a>. Для захисту чужих даних можемо попросити обґрунтовано підтвердити, що запит стосується саме вас.</p>" },
  { id: "security", title: "Захист даних", number: "07", content: "<p>Використовуємо HTTPS, антиспам-перевірку форми, обмеження доступу до робочого чату й секретів серверної інфраструктури. Жоден спосіб передавання даних через інтернет не гарантує абсолютної безпеки. У разі зміни інфраструктури переглядаємо заходи безпеки.</p>" },
  { id: "changes", title: "Чинність і зміни", number: "08", content: "<p>Редакція від <strong>11 листопада 2026 року</strong>. Актуальна версія публікується на цій сторінці. Істотні зміни в способах обробки даних відображатимуться в оновленій редакції.</p><p>Інформацію про майбутні комерційні умови наведено в <a href=\"/terms/\">умовах співпраці</a>. Подання заявки саме по собі не означає придбання послуг.</p>" },
];
---

<BaseLayout title="Політика конфіденційності — Noryvio" description="Як Noryvio обробляє дані, які ви передаєте через форму заявки." noindex={false}>
  <section class="nlegal-page" aria-labelledby="nlegal-title">
    <div class="nlegal-ambient" aria-hidden="true"></div>
    <div class="nlegal-container">
      <a class="nlegal-back" href="/"><span aria-hidden="true">←</span> На головну</a>
      <header class="nlegal-hero">
        <p class="nlegal-eyebrow"><span aria-hidden="true"></span> NORYVIO / ДОКУМЕНТИ</p>
        <h1 id="nlegal-title">Політика <span>конфіденційності.</span></h1>
        <p>Як Noryvio обробляє дані, які ви передаєте через форму заявки.</p>
        
      </header>
      <div class="nlegal-layout">
        <aside class="nlegal-index" aria-label="Зміст сторінки">
          <p>НА ЦІЙ СТОРІНЦІ</p>
          <nav aria-label="Розділи документа">
            {sections.map((item) => (
              <a href={`#${item.id}`}><span>{item.number}</span>{item.title}</a>
            ))}
          </nav>
        </aside>
        <div class="nlegal-document">
          {sections.map((item) => (
            <section class="nlegal-block" id={item.id}>
              <span class="nlegal-block__number">{item.number} / NORYVIO</span>
              <h2>{item.title}</h2>
              <div class="nlegal-copy" set:html={item.content} />
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
