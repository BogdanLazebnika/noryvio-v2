---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/legal.css";

// РОБОЧА ЧЕРНЕТКА. Не є публічною офертою або готовим договором.
// Перед початком приймання платежів: юридичне оформлення,
// реквізити, дати платежів, права на результат, перевірка юристом.
const provider = {
  name: "[ПІБ / РЕКВІЗИТИ ЗАРЕЄСТРОВАНОГО ВИКОНАВЦЯ]",
  email: "[EMAIL ДЛЯ ЗВЕРНЕНЬ ЩОДО ОПЛАТИ ТА СКАСУВАННЯ]",
};

const packages = [
  {
    name: "Landing Page",
    advance: 1990,
    monthly: 490,
    support: 299,
    description: "Односторінковий сайт у межах погодженого технічного завдання.",
  },
  {
    name: "Business Website",
    advance: 3990,
    monthly: 890,
    support: 499,
    description: "Багатосторінковий бізнес-сайт за погодженим обсягом робіт.",
  },
  {
    name: "E-commerce",
    advance: 6990,
    monthly: 1490,
    support: 999,
    description: "Базовий інтернет-магазин: остаточну комплектацію та платформу погоджуємо окремо.",
  },
];

const format = (amount: number) =>
  `${new Intl.NumberFormat("uk-UA").format(amount)} ₴`;

const sections = [
  { id: "pricing", label: "Базові пакети" },
  { id: "schedule", label: "Аванс і графік оплати" },
  { id: "scope", label: "Обсяг робіт і доплати" },
  { id: "cancel", label: "Скасування замовлення" },
  { id: "refund", label: "Повернення коштів" },
  { id: "overdue", label: "Прострочення платежів" },
  { id: "hosting", label: "Домен і хостинг" },
  { id: "support", label: "Підтримка після виплат" },
  { id: "transfer", label: "Права та передача сайту" },
  { id: "contact", label: "Контакти та статус" },
];
---

<BaseLayout
  title="Оплата та скасування замовлення — Noryvio"
  description="Умови оплати створення сайту частинами, авансу, зміни замовлення та припинення співпраці з Noryvio."
  noindex={true}
>
  <section class="nlegal-page npay-page" aria-labelledby="npay-title">
    <div class="nlegal-ambient" aria-hidden="true"></div>

    <div class="nlegal-container">
      <a class="nlegal-back" href="/terms/">
        <span aria-hidden="true">←</span>
        Повернутися до умов співпраці
      </a>

      <header class="nlegal-hero">
        <p class="nlegal-eyebrow">
          <span aria-hidden="true"></span>
          NORYVIO / ОПЛАТА ТА ЗАМОВЛЕННЯ
        </p>
        <h1 id="npay-title">Прозорі платежі. <span>Зрозумілі умови.</span></h1>
        <p>
          Пояснюємо, як плануємо приймати початковий внесок,
          розподіляти оплату розробки на 12 місяців та вирішувати
          питання змін або скасування замовлення.
        </p>

        <div class="nlegal-draft" role="note">
          <strong>Робоча чернетка — не публічна оферта.</strong>
          Умови набудуть практичного значення лише після юридичного оформлення
          виконавця, погодження індивідуального договору й перевірки юристом.
          До цього моменту жоден текст тут не означає приймання платежів на сайті.
        </div>
      </header>

      <div class="nlegal-layout">
        <aside class="nlegal-index" aria-label="Зміст документа">
          <p>ЗМІСТ ДОКУМЕНТА</p>
          <nav aria-label="Розділи правил оплати">
            {sections.map((item, index) => (
              <a href={`#${item.id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {item.label}
              </a>
            ))}
          </nav>
        </aside>

        <div class="nlegal-document">
          <section class="nlegal-block" id="pricing">
            <span class="nlegal-block__number">01 / ПАКЕТИ</span>
            <h2>Базова вартість створення сайтів</h2>
            <p>
              Ці суми відповідають базовим пакетам, представленим
              у <a href="/#pricing">калькуляторі Noryvio</a>.
              Остаточний перелік робіт, специфікація та договірна ціна
              підтверджуються до початку розробки.
            </p>

            <div class="npay-plans" aria-label="Заплановані базові ціни">
              {packages.map((plan) => (
                <article class="npay-plan">
                  <h3>{plan.name}</h3>
                  <p>{plan.description}</p>
                  <dl>
                    <div>
                      <dt>Початковий внесок</dt>
                      <dd>{format(plan.advance)}</dd>
                    </div>
                    <div>
                      <dt>12 платежів</dt>
                      <dd>{format(plan.monthly)} / міс.</dd>
                    </div>
                    <div class="npay-plan__sum">
                      <dt>Уся розробка</dt>
                      <dd>{format(plan.advance + 12 * plan.monthly)}</dd>
                    </div>
                    <div>
                      <dt>Необов’язковий супровід після виплат</dt>
                      <dd>{format(plan.support)} / міс.</dd>
                    </div>
                  </dl>
                </article>
              ))}
            </div>
            <p class="npay-caption">
              Ціна підтримки не входить до повної вартості розробки.
              Складні магазини та нестандартні інтеграції потребують окремої оцінки.
            </p>
          </section>

          <section class="nlegal-block" id="schedule">
            <span class="nlegal-block__number">02 / ГРАФІК</span>
            <h2>Аванс і 12 щомісячних платежів</h2>
            <p>
              Після погодження обсягу робіт сторони підписують окремий договір
              або погоджують іншу належну письмову форму. Початковий внесок
              зараховується в загальну ціну розробки та підтверджує початок
              виконання погодженого замовлення; це не додаткова прихована плата.
            </p>
            <p>
              Решта договірної ціни сплачується <strong>12 окремими щомісячними платежами</strong>
              за графіком, зазначеним у договорі. Запланована модель передбачає
              початок цих платежів після запуску сайту; конкретна дата першого
              платежу, наступні дати, порядок підтвердження запуску та реквізити
              визначаються в індивідуальному договорі.
            </p>
            <p>
              Повна вартість кожного пакета відома до початку роботи. Порядок
              дострокового погашення залишку платежів і можливі зміни графіка
              також погоджуються сторонами письмово. Платежі за створення сайту
              не є автоматичною оплатою підтримки після завершення розрахунків.
            </p>
          </section>

          <section class="nlegal-block" id="scope">
            <span class="nlegal-block__number">03 / ДОДАТКОВІ РОБОТИ</span>
            <h2>Що входить до ціни</h2>
            <p>
              Перед оплатою погоджуються технічне завдання, кількість сторінок,
              дизайн, інтеграції, матеріали замовника, строки та кількість
              включених раундів правок. Додаткові роботи — наприклад,
              нестандартна CRM, багатомовність або складна логіка магазину —
              виконуються після окремого погодження ціни й строків.
            </p>
            <p>
              Жодне розширення завдання саме по собі не змінює суму
              вже погодженого договору без належного узгодження сторін.
            </p>
          </section>

          <section class="nlegal-block" id="cancel">
            <span class="nlegal-block__number">04 / СКАСУВАННЯ</span>
            <h2>Як відмовитися від замовлення</h2>
            <p>
              Повідомлення про відмову або бажання змінити домовленості
              надсилається виконавцю за погодженим каналом зв’язку.
              Ми пропонуємо письмово зафіксувати дату звернення, стан
              виконання робіт, передані матеріали та взаємні розрахунки.
            </p>
            <div class="npay-scenarios">
              <div>
                <strong>До початку фактичної розробки</strong>
                <p>
                  Сторони звіряють уже понесені й належно обґрунтовані витрати.
                  Якщо законних підстав для утримання коштів немає, отриману суму
                  повертають. Сам факт назви платежу «аванс» не робить його
                  безповоротним.
                </p>
              </div>
              <div>
                <strong>Під час створення сайту</strong>
                <p>
                  Вартість виконаної частини роботи й можливі наслідки
                  припинення розраховуються з урахуванням договору та закону.
                  Замовнику надається інформація про результат і проведені
                  розрахунки. Безумовне утримання всіх коштів або стягнення
                  всіх майбутніх внесків не встановлюється.
                </p>
              </div>
              <div>
                <strong>Після запуску сайту</strong>
                <p>
                  Порядок припинення договору, доля непогашеної вартості,
                  збереження доступу, передача матеріалів і домену мають
                  визначатися окремим договором відповідно до прав сторін.
                  Оплата подальшого супроводу не стає обов’язковою лише через
                  те, що сайт уже запущений.
                </p>
              </div>
            </div>
            <p>
              Для фізичних осіб — споживачів застосовуються обов’язкові
              гарантії законодавства, зокрема правила дистанційних договорів,
              коли вони застосовні. Ця сторінка не обмежує законне право
              на відмову, усунення недоліків або відшкодування.
            </p>
          </section>

          <section class="nlegal-block" id="refund">
            <span class="nlegal-block__number">05 / ПОВЕРНЕННЯ</span>
            <h2>Як визначається сума повернення</h2>
            <p>
              Повернення коштів не визначається автоматично відсотком від
              авансу. Сторони мають документально підтвердити фактично
              виконану роботу, обґрунтовані витрати та інші обставини,
              які мають правове значення. За потреби складається письмовий
              розрахунок із переліком виконаних робіт.
            </p>
            <p>
              Спосіб, строк і реквізити повернення погоджуються відповідно
              до чинного законодавства. Обов’язкові строки та права споживача,
              якщо вони застосовні, мають перевагу над умовами цієї чернетки.
              Остаточну процедуру повернення й документи потрібно закріпити
              в індивідуальному договорі.
            </p>
          </section>

          <section class="nlegal-block" id="overdue">
            <span class="nlegal-block__number">06 / НЕСПЛАТА</span>
            <h2>Як діємо при затримці платежу</h2>
            <p>
              Якщо платіж прострочено, сторони насамперед звіряють його статус
              та погоджують подальші дії. Порядок повідомлення, можливий строк
              для усунення прострочення, наслідки порушення графіка та будь-яка
              відповідальність мають бути чітко визначені в договорі й не
              суперечити закону.
            </p>
            <p>
              Автоматичне видалення сайту, позбавлення клієнта його домену
              або безпідставне блокування доступу не є умовами цієї чернетки.
              Так само ми не встановлюємо довільних штрафів без договору.
            </p>
          </section>

          <section class="nlegal-block" id="hosting">
            <span class="nlegal-block__number">07 / ІНФРАСТРУКТУРА</span>
            <h2>Домен, SSL і хостинг</h2>
            <p>
              Запланована базова комплектація включає налаштування хостингу,
              HTTPS/SSL і реєстрацію нового домену на перший рік у межах
              бюджету <strong>до 800 грн</strong> (якщо це погоджено для
              конкретного замовлення). Дорожчий домен оплачується за окремим
              погодженням; продовження після першого року — за фактичним тарифом
              реєстратора.
            </p>
            <p>
              Домен реєструється на дані замовника або передається йому
              відповідно до погоджених умов. За потреби платного хостингу,
              додаткових ліцензій чи сторонніх сервісів їх вартість потрібно
              узгодити до підключення. Перший рік домену рахується з дати
              його реєстрації, а не обов’язково з дати першого платежу.
            </p>
          </section>

          <section class="nlegal-block" id="support">
            <span class="nlegal-block__number">08 / ПІСЛЯ РОЗРОБКИ</span>
            <h2>Подальша підтримка — за вибором клієнта</h2>
            <p>
              Після погашення повної ціни розробки клієнт може окремо
              замовити супровід. Орієнтовні базові ставки, наведені в тарифах:
              <strong>299 ₴/міс.</strong> для Landing Page,
              <strong>499 ₴/міс.</strong> для Business Website,
              <strong>999 ₴/міс.</strong> для базового E-commerce.
              Остаточний перелік робіт фіксується в окремих умовах підтримки.
            </p>
            <p>
              Автоматичний моніторинг може працювати постійно, однак він
              не дорівнює гарантії цілодобової ручної допомоги або
              необмеженим правкам. Припинення необов’язкового супроводу
              не означає автоматичну втрату оплаченого сайту.
            </p>
          </section>

          <section class="nlegal-block" id="transfer">
            <span class="nlegal-block__number">09 / ПРАВА</span>
            <h2>Передача результату та права на сайт</h2>
            <p>
              Умови приймання сайту, передання вихідних файлів, доступів,
              майнових прав і ліцензій на сторонні компоненти визначаються
              індивідуальним договором. Сторони окремо погоджують, що саме
              передається після повного розрахунку та як відбувається перенесення
              на інший хостинг.
            </p>
            <p>
              Власність на домен і законні права замовника на вже оплачений
              результат не повинні залежати від примусового продовження
              додаткової підтримки.
            </p>
          </section>

          <section class="nlegal-block" id="contact">
            <span class="nlegal-block__number">10 / РЕКВІЗИТИ</span>
            <h2>Хто приймає звернення</h2>
            <p>
              Запланований виконавець: <strong>{provider.name}</strong>.
              Електронна адреса для питань оплати, скасування та повернення:
              <strong>{provider.email}</strong>. Всі індивідуальні реквізити,
              канали зв’язку та платіжні дані будуть зазначені після
              належного оформлення діяльності.
            </p>
            <p>
              Також перегляньте <a href="/terms/">загальні умови співпраці</a>
              та <a href="/privacy/">політику конфіденційності</a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .npay-plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
    margin: 25px 0 21px;
  }

  .npay-plan {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
    padding: 19px;
    border: 1px solid rgba(36, 229, 193, .21);
    border-radius: 18px;
    background: linear-gradient(150deg, #11302e, #0b191e 72%);
  }

  .npay-plan h3 {
    margin: 0;
    font-size: 16px;
    color: #e8fffa;
  }

  .npay-plan > p {
    margin: 0 0 7px;
    font-size: 12px;
    line-height: 1.65;
    color: #a9bfc1;
  }

  .npay-plan dl { display: grid; gap: 12px; margin: auto 0 0; }
  .npay-plan dl > div { display: grid; gap: 5px; }
  .npay-plan dt { color: #9bb9b9; font-size: 11px; line-height: 1.5; }
  .npay-plan dd { margin: 0; color: #f2fffc; font-weight: 800; font-size: 14px; font-variant-numeric: tabular-nums; }
  .npay-plan__sum { padding-top: 12px; border-top: 1px solid rgba(167, 241, 223, .16); }
  .npay-plan__sum dd { color: #24e5c1; font-size: 19px; }
  .npay-caption { font-size: 12px !important; }

  .npay-scenarios { display: grid; gap: 12px; margin: 24px 0; }
  .npay-scenarios > div {
    border-left: 2px solid rgba(36, 229, 193, .6);
    border-radius: 0 12px 12px 0;
    background: rgba(36, 229, 193, .045);
    padding: 19px 21px;
  }
  .npay-scenarios strong { display: block; margin-bottom: 9px; color: #e9fff9; font-size: 13px; }
  .npay-scenarios p { margin: 0; }

  @media (max-width: 1120px) { .npay-plans { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .npay-plan { padding: 17px; }
    .npay-scenarios > div { padding: 16px; }
  }
</style>
